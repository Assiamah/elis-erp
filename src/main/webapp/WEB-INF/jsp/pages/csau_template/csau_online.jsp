<script>
/* Tab card highlighting; no change to existing application search handlers. */
document.addEventListener('DOMContentLoaded',function(){
 var cards=document.querySelectorAll('.client-app-green .card-hover[data-bs-toggle="tab"]');
 cards.forEach(function(card){card.addEventListener('click',function(){cards.forEach(function(c){c.classList.remove('active','bg-danger','bg-success','bg-warning','bg-info','bg-opacity-10')});card.classList.add('active')})});
 /* PDF upload controls may be provided by a separate modal component.
    Bind only when that component exists to avoid interrupting this page. */
 var input=document.getElementById('fileUploadFormatCSAU');
 if(!input)return;
 var select=document.getElementById('btnSelectFile'),remove=document.getElementById('btnRemoveFile'),view=document.getElementById('btnViewFile');
 var info=document.getElementById('fileInfo'),name=document.getElementById('fileName'),size=document.getElementById('fileSize');
 var progress=document.getElementById('fileSizeProgress'),error=document.getElementById('fileValidationError'),sizeError=document.getElementById('sizeError');
 var area=document.querySelector('.file-upload-area');var max=10*1024*1024;
 function format(bytes){if(!bytes)return '0 Bytes';var k=1024,u=['Bytes','KB','MB','GB'],i=Math.floor(Math.log(bytes)/Math.log(k));return (bytes/Math.pow(k,i)).toFixed(2)+' '+u[i]}
 function showError(message){if(error){error.textContent=message;error.style.display='block'}if(area){area.classList.add('border-danger');setTimeout(function(){area.classList.remove('border-danger')},5000)}}
 function reset(){input.value='';if(info)info.style.display='none';if(progress)progress.style.display='none';if(error)error.style.display='none';if(sizeError)sizeError.style.display='none';input.setCustomValidity('Please select a valid PDF file.')}
 function validate(file){if(!file||file.type!=='application/pdf'||file.size>max||file.size===0){var msg=!file?'Please select a PDF file.':file.type!=='application/pdf'?'Please select a PDF file only.':file.size>max?'File size ('+format(file.size)+') exceeds 10MB limit.':'The selected file is empty.';reset();showError(msg);return false}if(name)name.textContent=file.name.length>30?file.name.slice(0,26)+'...pdf':file.name;if(size)size.textContent=format(file.size);if(info)info.style.display='block';if(error)error.style.display='none';if(sizeError)sizeError.style.display='none';if(progress){var pct=file.size/max*100;progress.style.display=file.size>1048576?'block':'none';var bar=progress.querySelector('.progress-bar');if(bar){bar.className='progress-bar '+(pct>=90?'bg-danger':pct>=70?'bg-warning':'bg-success');bar.style.width=Math.min(pct,100)+'%'}}input.setCustomValidity('');return true}
 if(select)select.addEventListener('click',function(){input.click()});
 input.addEventListener('change',function(){if(input.files.length)validate(input.files[0])});
 if(remove)remove.addEventListener('click',reset);
 if(area){area.addEventListener('dragover',function(e){e.preventDefault();area.classList.add('dragover')});area.addEventListener('dragleave',function(e){e.preventDefault();area.classList.remove('dragover')});area.addEventListener('drop',function(e){e.preventDefault();area.classList.remove('dragover');if(e.dataTransfer.files.length){var file=e.dataTransfer.files[0];if(validate(file)){var dt=new DataTransfer();dt.items.add(file);input.files=dt.files}}})}
 if(view)view.addEventListener('click',function(){if(!input.files.length||!validate(input.files[0])){if(typeof Swal!=='undefined')Swal.fire('No Valid File','Please select a PDF file first.','warning');return}var file=input.files[0],url=URL.createObjectURL(file);var existing=document.getElementById('pdfViewerModal');if(existing)existing.remove();var modal=document.createElement('div');modal.className='modal fade';modal.id='pdfViewerModal';modal.tabIndex=-1;modal.innerHTML='<div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><h6 class="modal-title"><i class="fas fa-file-pdf me-2"></i><span id="pdfSafeName"></span></h6><div><button type="button" class="btn btn-sm btn-outline-light me-2" id="btnDownloadPDF"><i class="fas fa-download"></i> Download</button><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div></div><div class="modal-body p-0"><div class="pdf-toolbar p-2 border-bottom d-flex align-items-center justify-content-between"><div><button class="btn btn-sm btn-outline-dark" id="btnPrevPage">&#8249;</button> <span id="currentPage">1</span> / <span id="totalPages">0</span> <button class="btn btn-sm btn-outline-dark" id="btnNextPage">&#8250;</button></div><select class="form-select form-select-sm" id="zoomSelect" style="width:110px"><option value="0.5">50%</option><option value="0.75">75%</option><option value="1" selected>100%</option><option value="1.25">125%</option><option value="1.5">150%</option><option value="2">200%</option></select></div><div class="pdf-container p-3 text-center"><canvas id="pdfCanvas"></canvas><div class="d-none text-danger" id="pdfError">Unable to load PDF.</div></div></div><div class="modal-footer"><button class="btn btn-outline-dark" data-bs-dismiss="modal">Close</button></div></div></div>';document.body.appendChild(modal);modal.querySelector('#pdfSafeName').textContent=file.name;var instance=new bootstrap.Modal(modal);modal.addEventListener('hidden.bs.modal',function(){URL.revokeObjectURL(url);modal.remove()},{once:true});modal.querySelector('#btnDownloadPDF').addEventListener('click',function(){var a=document.createElement('a');a.href=url;a.download=file.name;a.click()});instance.show();modal.addEventListener('shown.bs.modal',async function(){try{if(typeof pdfjsLib==='undefined'){await new Promise(function(resolve,reject){var s=document.createElement('script');s.src='https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js';s.onload=resolve;s.onerror=reject;document.head.appendChild(s)})}pdfjsLib.GlobalWorkerOptions.workerSrc='https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';var pdf=await pdfjsLib.getDocument(url).promise,pageNum=1,scale=1;modal.querySelector('#totalPages').textContent=pdf.numPages;async function render(){var page=await pdf.getPage(pageNum),viewport=page.getViewport({scale:scale}),canvas=modal.querySelector('#pdfCanvas');canvas.width=viewport.width;canvas.height=viewport.height;await page.render({canvasContext:canvas.getContext('2d'),viewport:viewport}).promise;modal.querySelector('#currentPage').textContent=pageNum}await render();modal.querySelector('#btnPrevPage').addEventListener('click',async function(){if(pageNum>1){pageNum--;await render()}});modal.querySelector('#btnNextPage').addEventListener('click',async function(){if(pageNum<pdf.numPages){pageNum++;await render()}});modal.querySelector('#zoomSelect').addEventListener('change',async function(){scale=parseFloat(this.value);await render()})}catch(e){console.error(e);modal.querySelector('#pdfError').classList.remove('d-none')}},{once:true})});
 var form=input.closest('form');if(form)form.addEventListener('submit',function(e){if(!input.files.length||!validate(input.files[0])){e.preventDefault();return}var upload=document.getElementById('btnUploadFile');if(upload){upload.innerHTML='<span class="spinner-border spinner-border-sm me-2"></span>Uploading...';upload.disabled=true}});
});
</script>

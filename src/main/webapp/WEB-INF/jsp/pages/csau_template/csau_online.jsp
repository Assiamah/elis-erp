<style>
/* ELIS Client Application Management — colour-only, scoped theme */
.client-app-green{--elis-green:#07543f;--elis-emerald:#0b8a61;--elis-mint:#dff6e9;--elis-border:#cde9d9}
.client-app-green .page-header-breadcrumb{background:linear-gradient(110deg,#07543f,#0b8a61)!important;border-radius:12px;padding:19px 24px;box-shadow:0 6px 18px rgba(7,84,63,.16)}
.client-app-green .page-header-breadcrumb .page-title,.client-app-green .page-header-breadcrumb .breadcrumb-item,.client-app-green .page-header-breadcrumb .breadcrumb-item a,.client-app-green .page-header-breadcrumb .breadcrumb-item.active{color:#fff!important}
.client-app-green .page-header-breadcrumb .breadcrumb-item+.breadcrumb-item::before{color:#c4f2db!important}
.client-app-green .card{border-color:var(--elis-border)}
.client-app-green .card-hover{transition:transform .25s ease,box-shadow .25s ease;border:1px solid #9bd8ba!important;height:100%;background:#fff}
.client-app-green .card-hover:hover{transform:translateY(-4px);box-shadow:0 8px 20px rgba(7,84,63,.14)!important;border-color:var(--elis-emerald)!important}
.client-app-green .card-hover.active{border:2px solid var(--elis-emerald)!important;box-shadow:0 6px 18px rgba(7,84,63,.16)!important;background:#eaf8f0!important}
.client-app-green .card-hover .card-footer{background:#eaf8f0!important}
.client-app-green .card-hover .card-footer small,.client-app-green .card-hover .card-body>div>i{color:var(--elis-green)!important}
.client-app-green .tab-pane .card-header,.client-app-green .instructions-card>.card-header{background:linear-gradient(110deg,#07543f,#0b8a61)!important;color:#fff!important;border-radius:8px}
.client-app-green .tab-pane .card-header h5,.client-app-green .instructions-card>.card-header h5,.client-app-green .tab-pane .card-header i,.client-app-green .instructions-card>.card-header i{color:#fff!important}
.client-app-green .table thead th{background:#07543f!important;color:#fff!important;border-color:#137655!important;white-space:nowrap}
.client-app-green .table-hover tbody tr:hover{background:#f0faf4}
.client-app-green .btn-danger,.client-app-green .btn-primary,.client-app-green .btn-info,.client-app-green .btn-warning{background:linear-gradient(110deg,#08704f,#0b9568)!important;border-color:#08704f!important;color:#fff!important}
.client-app-green .btn-danger:hover,.client-app-green .btn-primary:hover,.client-app-green .btn-info:hover,.client-app-green .btn-warning:hover{background:#07543f!important;border-color:#07543f!important}
.client-app-green .form-control:focus,.client-app-green .form-select:focus{border-color:#0b8a61!important;box-shadow:0 0 0 .2rem rgba(11,138,97,.13)!important}
.client-app-green .input-group-text{background:#eaf8f0!important;color:#07543f!important}
.client-app-green .instructions-card .alert{background:#f0faf4!important;border-color:#cde9d9!important;color:#23493a!important}
.client-app-green .instructions-card .alert .fw-semibold{color:#07543f}
.client-app-green .instructions-card .alert .text-muted{color:#526b60!important}
.client-app-green .dataTables_wrapper .page-item.active .page-link{background:#087b57!important;border-color:#087b57!important}
.client-app-green .dataTables_wrapper .page-link{color:#07543f}
#pdfViewerModal .modal-header{background:linear-gradient(110deg,#07543f,#0b8a61)!important;color:#fff!important}
#pdfViewerModal .modal-title{color:#fff!important}
#pdfViewerModal .btn-close{filter:invert(1) grayscale(1)}
#pdfViewerModal .pdf-toolbar{background:#eaf8f0!important}
#pdfViewerModal .modal-footer{background:#f3faf6!important}
#pdfViewerModal .btn-primary{background:#087b57!important;border-color:#087b57!important}
#pdfCanvas{max-width:100%;border:1px solid #cde9d9;border-radius:4px}
#pdfViewerModal .modal-dialog{max-width:70%}
#pdfViewerModal .modal-body{min-height:70vh;max-height:80vh;overflow:hidden}
#pdfViewerModal .pdf-container{overflow:auto;max-height:calc(70vh - 100px)}
#pdfViewerModal .pdf-toolbar{position:sticky;top:0;z-index:1}
@media(max-width:768px){#pdfViewerModal .modal-dialog{max-width:95%;margin:.5rem}}
</style>

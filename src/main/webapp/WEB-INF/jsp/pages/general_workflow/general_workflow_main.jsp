<!-- ADD REQUEST -->
<div class="modal fade effect-scale modal-blur gwf-modal" id="addRequestModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static"><div class="modal-dialog modal-dialog-centered"><div class="modal-content border-0 shadow-lg"><div class="modal-header"><h5 class="modal-title"><i class="ri-add-circle-line me-2"></i>Add New Request</h5><button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body"><div class="alert alert-info mb-4 d-flex gap-3 align-items-center"><i class="ri-information-line fs-3"></i><div><h6 class="mb-1">Search and Add Request</h6><p class="mb-0 small">Select request purpose and reference type to search for applications.</p></div></div><form id="addRequestForm"><div class="card mb-3"><div class="card-header py-2"><h6 class="mb-0"><i class="ri-focus-3-line me-2"></i>Request Purpose</h6></div><div class="card-body"><label class="form-label" for="gwf_request_purpose">Select Request Purpose</label><div class="input-group"><span class="input-group-text"><i class="ri-list-check"></i></span><select class="form-select" id="gwf_request_purpose" required><option value="" disabled selected>-- Select Purpose --</option></select></div><small class="text-muted d-block mt-2">Choose the purpose for this request.</small></div></div><div class="card mb-3"><div class="card-header py-2"><h6 class="mb-0"><i class="ri-search-line me-2"></i>Search Criteria</h6></div><div class="card-body"><div class="mb-3"><label class="form-label" for="gwf_request_reference_type">Reference Type</label><div class="input-group"><span class="input-group-text"><i class="ri-filter-line"></i></span><select class="form-select" id="gwf_request_reference_type" required><option value="" disabled selected>-- Select Reference Type --</option><option value="Job Number">Job Number</option><option value="Certificate Number">Certificate Number</option><option value="Parcel ID">Parcel ID</option><option value="GLPIN">GLPIN</option></select></div></div><div><label class="form-label" for="gwf_request_keyword">Search Keyword</label><div class="input-group"><span class="input-group-text"><i class="ri-search-line"></i></span><input type="text" class="form-control" id="gwf_request_keyword" placeholder="Enter search keyword" required></div></div></div></div><div id="validationFeedback" class="alert alert-warning d-none"><i class="ri-alert-line me-2"></i><span id="validationMessage">Please fill in all required fields</span></div></form></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal"><i class="ri-close-line me-1"></i>Cancel</button><button type="button" id="btn_check_request" class="btn btn-success px-4"><i class="ri-search-line me-1"></i>Search &amp; Check</button></div></div></div></div>
<!-- REQUEST DISTRIBUTION: one modal instance, with unit and individual distribution -->
<div class="modal fade gwf-modal" id="jobsListModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable"><div class="modal-content"><div class="modal-header"><h5 class="modal-title" id="jobsListModalLabel"><i class="ri-send-plane-line me-2"></i>Request List Processing</h5><button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body p-4"><div class="card mb-4"><div class="card-body"><ul class="nav nav-tabs nav-fill" id="distributionTab" role="tablist"><li class="nav-item"><button type="button" class="nav-link active" id="unit-tab" data-bs-toggle="tab" data-bs-target="#unit-distribution" role="tab"><i class="ri-building-line me-1"></i>Send to Unit</button></li><li class="nav-item"><button type="button" class="nav-link" id="individual-tab" data-bs-toggle="tab" data-bs-target="#individual-distribution" role="tab"><i class="ri-user-line me-1"></i>Send to Individual</button></li></ul><div class="tab-content pt-3" id="distributionTabContent"><div class="tab-pane fade show active" id="unit-distribution" role="tabpanel"><div class="row g-3"><div class="col-md-5"><label class="form-label">Division</label><select id="req_unit_division_to_send_to" class="form-select"><option value="none" disabled selected>Select Division</option><option value="LVD">LVD</option><option value="LRD">LRD</option><option value="PVLMD">PVLMD</option><option value="SMD">SMD</option><option value="RLO">RLO</option><option value="CORPORATE">CORPORATE</option></select></div><div class="col-md-7"><label class="form-label">Unit</label><div class="input-group"><input class="form-control" id="req_unit_to_send_to" type="text" list="listofunitsbatching" placeholder="Select Unit"><datalist id="listofunitsbatching"></datalist><button class="btn btn-outline-secondary" type="button" id="refreshUnits"><i class="ri-refresh-line"></i></button></div></div></div></div><div class="tab-pane fade" id="individual-distribution" role="tabpanel"><div class="row g-3"><div class="col-md-4"><label class="form-label">Division/Unit</label><input class="form-control" id="user_divsion" type="text" value="${unit_name}" readonly></div><div class="col-md-8"><label class="form-label">User</label><div class="input-group"><input class="form-control" id="req_user_to_send_to" type="text" list="listofusersbatching" placeholder="Search user..."><datalist id="listofusersbatching"></datalist><button class="btn btn-outline-secondary" type="button" id="refreshUsers"><i class="ri-refresh-line"></i></button></div></div></div></div></div></div></div><div class="card"><div class="table-responsive"><table class="table table-hover align-middle mb-0 small" id="selectedJobsTable"><thead><tr><th>Job Number</th><th>Application</th><th>Type</th><th>Purpose</th><th>Remarks</th><th>Actions</th></tr></thead><tbody><tr class="no-jobs"><td colspan="6" class="text-center py-4 text-muted">No jobs selected</td></tr></tbody></table></div></div></div><div class="modal-footer"><button type="button" class="btn btn-outline-danger" id="btnRemoveAllJobs"><i class="ri-delete-bin-line me-1"></i>Clear All</button><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button type="button" class="btn btn-primary" id="btnSubmitJobs"><i class="ri-send-plane-line me-1"></i>Submit Request</button></div></div></div></div>
<script type="text/javascript">
/* Existing service contracts and element IDs retained. */
var selectedJobsList = [];
(function ($) {
'use strict';
function parseResponse(value) { return typeof value === 'string' ? JSON.parse(value) : value; }
function modalShow(id) { var el=document.getElementById(id); if(el) bootstrap.Modal.getOrCreateInstance(el).show(); }
function modalHide(id) { var el=document.getElementById(id); if(el) { var m=bootstrap.Modal.getInstance(el); if(m) m.hide(); } }
function alertError(message) { Swal.fire({title:'Error',text:message,icon:'error',confirmButtonColor:'#087f5b'}); }
function warn(message) { Swal.fire({title:'Warning',text:message,icon:'warning',confirmButtonColor:'#087f5b'}); }
function escapeHtml(v) { return $('<div>').text(v==null?'':String(v)).html(); }
function jobKey(j) { return String(j.jobNumberPlain || j.job_number || ''); }
function normalizeJob(j) { return {jobNumberPlain:j.jobNumberPlain||j.job_number||'',jobNumberHtml:j.jobNumberHtml||j.job_number||'',applicantNameHtml:j.applicantNameHtml||j.ar_name||'N/A',applicationType:j.applicationType||j.business_process_sub_name||'',batchingPurpose:j.batchingPurpose||j.job_purpose||'',remarksNotes:j.remarksNotes||j.remarks_notes||''}; }
function persistJobs() { localStorage.setItem('requestlistdata',JSON.stringify(selectedJobsList)); localStorage.setItem('requestBatchingListData',JSON.stringify(selectedJobsList)); updateRequestListCount(); }
function addJob(job) { job=normalizeJob(job); if(selectedJobsList.some(function(j){return jobKey(j)===jobKey(job);})) {warn('Job '+jobKey(job)+' is already in the list.');return false;} selectedJobsList.push(job);persistJobs();updateSelectedJobsTable();return true; }
function updateRequestListCount() { $('#requestListCount').text(selectedJobsList.length); $('#btnViewRequestList').toggle(selectedJobsList.length>0); }
function updateSelectedJobsTable() { var body=$('#selectedJobsTable tbody').empty(); if(!selectedJobsList.length){body.append('<tr class="no-jobs"><td colspan="6" class="text-center py-4 text-muted"><i class="ri-inbox-line fs-2 d-block mb-2"></i>No jobs selected</td></tr>');return;} selectedJobsList.forEach(function(j){var row=$('<tr>');[jobKey(j),j.applicantNameHtml,j.applicationType,j.batchingPurpose,j.remarksNotes].forEach(function(value){row.append($('<td>').text(value||''));});row.append($('<td>').append($('<button type="button" class="btn btn-sm btn-danger btn-remove-job"><i class="ri-delete-bin-line"></i></button>').attr('data-job-number',jobKey(j))));body.append(row);}); }
window.updateSelectedJobsTable=updateSelectedJobsTable;
window.updateRequestListCount=updateRequestListCount;
window.addRequestToListxx=function(job_number,ar_name,business_process_sub_name,job_recieved_by,job_purpose,remarks_notes){addJob({job_number:job_number,ar_name:ar_name,business_process_sub_name:business_process_sub_name,job_purpose:job_purpose,remarks_notes:remarks_notes});};
window.showJobsListModal=function(){loadUsers();updateSelectedJobsTable();modalShow('jobsListModal');};
window.showAddRequestModal=window.showJobsListModal;
function prepareRequestlistModal(){updateSelectedJobsTable();modalShow('jobsListModal');}
window.prepareRequestlistModal=prepareRequestlistModal;
function addJobToRequestlist(){persistJobs();updateSelectedJobsTable();}
window.addJobToRequestlist=addJobToRequestlist;
function loadUsers(){ $.ajax({type:'POST',url:'Case_Management_Serv',data:{request_type:'get_lc_list_of_users'},beforeSend:function(){$('#refreshUsers i').addClass('fa-spin');},success:function(result){try{var users=parseResponse(result),region=$('#regional_code_general').text().trim(),division=$('#user_divsion').val(),list=$('#listofusersbatching').empty();(Array.isArray(users)?users:(users.data||[])).forEach(function(u){if(u.unit_name===division&&String(u.regional_code)===region) $('<option>').val(u.fullname).attr('data-id',u.userid).attr('data-name',u.fullname).appendTo(list);});}catch(e){console.error(e);}},complete:function(){$('#refreshUsers i').removeClass('fa-spin');}}); }
function loadUnits(){var division=$('#req_unit_division_to_send_to').val();$('#req_unit_to_send_to').val('');$.ajax({type:'POST',url:'Case_Management_Serv',data:{request_type:'get_lc_list_of_units'},success:function(result){try{var response=parseResponse(result),list=$('#listofunitsbatching').empty();(response.data||[]).forEach(function(u){if(String(u.unit_division||'').includes(division)) $('<option>').val(u.unit_name).attr('data-id',u.unit_id).attr('data-name',u.unit_name).appendTo(list);});}catch(e){console.error(e);}}});}
function getStatusClass(status){switch(String(status||'').toLowerCase()){case 'approved':case 'completed':return 'success';case 'pending':return 'warning';case 'queried':return 'danger';default:return 'info';}}

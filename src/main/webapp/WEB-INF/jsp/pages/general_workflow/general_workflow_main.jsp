function handleArchiveJobClick(job,rqId){if(!job)return;Swal.fire({title:'Archive Job',html:'<p>Job Number: '+escapeHtml(job.job_number)+'</p><textarea class="form-control" id="gwf_archive_remarks" rows="3" placeholder="Enter remarks"></textarea>',icon:'warning',showCancelButton:true,confirmButtonText:'Yes, Archive',confirmButtonColor:'#c94f4f',preConfirm:function(){var r=$('#gwf_archive_remarks').val().trim();if(!r){Swal.showValidationMessage('Remarks are required');return false;}return r;}}).then(function(result){if(!result.isConfirmed)return;$.ajax({type:'POST',url:'Case_Management_Serv',data:{request_type:'select_archive_application_request',job_number:job.job_number,note:result.value,rq_id:rqId},success:function(response){try{if(parseResponse(response).success)Swal.fire({title:'Success',text:'Job archived successfully',icon:'success'}).then(function(){location.reload();});else alertError('Failed to archive job');}catch(e){alertError('Unexpected server response');}},error:function(){alertError('Failed to archive job');}});});}
function generateRequestListPDF(list,batch,sendToName,sendToId){$.ajax({type:'POST',url:'GenerateCaseReports',data:{request_type:'request_to_generate_request_list',list_of_application:list,batch_number:batch,modified_by:localStorage.getItem('fullname'),modified_by_id:localStorage.getItem('userid'),send_to_name:sendToName,send_to_id:sendToId},xhrFields:{responseType:'blob'},beforeSend:function(){Swal.fire({title:'Generating Report',text:'Please wait while we prepare your request list...',allowOutsideClick:false,didOpen:function(){Swal.showLoading();}});},success:function(data){Swal.close();var url=URL.createObjectURL(new Blob([data],{type:'application/pdf'}));$('#elisdovumentpreviewblobfile').attr('src',url);modalHide('jobsListModal');var preview=document.getElementById('elisDocumentPreview');if(preview)bootstrap.Modal.getOrCreateInstance(preview,{backdrop:'static'}).show();else window.open(url,'_blank');selectedJobsList=[];persistJobs();updateSelectedJobsTable();},error:function(){alertError('Failed to generate the request list PDF');}});}

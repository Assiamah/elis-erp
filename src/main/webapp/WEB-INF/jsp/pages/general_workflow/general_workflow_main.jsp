 <div class="card custom-card gwf-main-card mt-3"><div class="card-header d-flex justify-content-between align-items-center gap-2"><div><h5 class="card-title mb-1">Request Details</h5><p class="small mb-0 filter-status"></p></div><div class="d-flex gap-2 flex-wrap"><button type="button" class="btn btn-warning label-btn" id="btnViewRequestlist"><i class="ri-list-check me-1"></i>View Request List</button><button type="button" class="btn btn-secondary label-btn d-none" id="btn_add_request_all"><i class="ri-checkbox-circle-line me-1"></i>Add All To Request List</button><button type="button" class="btn btn-danger label-btn d-none" id="btn_add_archive_all"><i class="ri-delete-bin-line me-1"></i>Add All To Archive List</button><button type="button" class="btn btn-sm btn-info btnLoadData" data-id="2"><i class="ri-group-line me-1"></i>Request With Officers <span class="badge bg-white text-success ms-1">${with_officers}</span></button></div></div>
 <div class="card-body"><div class="table-responsive"><table id="requestsTable" class="table table-hover align-middle mb-0"><thead><tr><th width="50"><div class="form-check d-flex justify-content-center"><input class="form-check-input" type="checkbox" id="selectAll"></div></th><th>Requested Date</th><th>Job Number</th><th>Application</th><th>Type</th><th>Purpose</th><th>Comment</th><th id="inbox_text">Requested By</th><th width="120" class="text-center">Status</th><th width="120" class="text-end">Actions</th></tr></thead><tbody class="small"></tbody></table></div></div></div>

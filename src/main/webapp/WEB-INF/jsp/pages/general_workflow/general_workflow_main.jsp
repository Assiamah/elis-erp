function button(type,item){var btn=$('<button type="button" class="btn btn-sm">');if(type==='view')btn.addClass('btn-info btn-view-job').attr('data-id',item.case_number).html('<i class="ri-eye-line"></i>');if(type==='send')btn.addClass('btn-warning btn-add-to-list').attr('data-id',item.job_number).html('<i class="ri-send-plane-line"></i>');if(type==='archive')btn.addClass('btn-danger btn-archive-job').attr('data-id',item.rq_id).html('<i class="ri-archive-line"></i>');if(type==='work')btn.addClass('btn-success btn-work-job').attr({'data-rq_id':item.rq_id,'data-job_number':item.job_number,'data-case_number':item.case_number,'data-transaction_number':item.transaction_number,'data-job_purpose':item.job_purpose,'data-business_process_sub_name':item.business_process_sub_name,'data-review_instruction':item.review_instruction}).html('<i class="ri-edit-line"></i>');return btn.prop('outerHTML');}
function updateTable(data,inboxType){var dt=$('#requestsTable').DataTable();dt.clear();data.forEach(function(item){var actions='<div class="btn-group" role="group">';actions+=button('view',item);if([1,2,3,5].includes(inboxType))actions+=button('send',item);if([3,4].includes(inboxType))actions+=button('archive',item);if([3,5].includes(inboxType))actions+=button('work',item);actions+='</div>';var cells=['<div class="form-check d-flex justify-content-center"><input class="form-check-input gwf-row-check" type="checkbox"><input class="rq_id" type="hidden" value="'+escapeHtml(item.rq_id)+'"></div>',escapeHtml(item.created_on),'<span class="text-primary">'+escapeHtml(item.job_number)+'</span>',escapeHtml(item.ar_name),escapeHtml(item.business_process_sub_name),escapeHtml(item.job_purpose),escapeHtml(inboxType===2?(item.officer_comments||'--'):(item.remarks||'--')),escapeHtml([2,4].includes(inboxType)?item.job_recieved_by:item.job_forwarded_by),'<span class="badge bg-'+getStatusClass(item.job_status)+'">'+escapeHtml(item.job_status)+'</span>',actions];var node=dt.row.add(cells).node();$(node).data('job-data',item);if(inboxType===4&&String(item.remarks||'').toUpperCase()==='COMPLETED')$(node).addClass('table-success');});dt.draw(false);}
function postForm(action,fields){var form=$('<form method="POST" style="display:none">').attr('action',action);Object.keys(fields).forEach(function(k){$('<input type="hidden">').attr('name',k).val(fields[k]||'').appendTo(form);});form.appendTo('body').trigger('submit');}
function requestRemarks(title,callback){Swal.fire({title:title,html:'<div class="text-start"><label for="gwf_remarks" class="form-label">Remarks <span class="text-danger">*</span></label><textarea class="form-control" id="gwf_remarks" rows="3"></textarea></div>',icon:'question',showCancelButton:true,confirmButtonText:'Yes, Add',confirmButtonColor:'#087f5b',preConfirm:function(){var v=$('#gwf_remarks').val().trim();if(!v){Swal.showValidationMessage('Remarks are required');return false;}return v;}}).then(function(result){if(result.isConfirmed)callback(result.value);});}

<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c" %>
<%@ taglib uri="http://java.sun.com/jsp/jstl/functions" prefix="fn" %>
<%@ page import="org.codehaus.jettison.json.*" %>
<%@ page import="java.sql.*" %>
<%@ page import="javax.naming.*" %>
<%@ page import="java.util.*" %>
<style>
.frrv-shell{--frrv-dark:#064b39;--frrv-deep:#053d2e;--frrv-primary:#087f5b;--frrv-bright:#0a9869;--frrv-light:#e9f7ee;--frrv-border:#cce8d8;--frrv-text:#244438;color:var(--frrv-text)}
.frrv-shell .page-container{background:linear-gradient(180deg,#f7fbf8,#eff8f2);padding-bottom:2rem}
.frrv-shell .page-header-breadcrumb{background:linear-gradient(115deg,#064b39,#087f5b 65%,#0a9869);border-radius:15px;padding:20px 24px;box-shadow:0 10px 25px rgba(6,75,57,.17)}
.frrv-shell .page-header-breadcrumb .page-title,.frrv-shell .page-header-breadcrumb .page-title span,.frrv-shell .breadcrumb-item,.frrv-shell .breadcrumb-item a,.frrv-shell .breadcrumb-item.active{color:white!important}
.frrv-shell .breadcrumb-item+.breadcrumb-item::before{color:#c7edda!important}
.frrv-shell .frrv-hero-card{border:0;border-radius:16px;overflow:hidden;background:radial-gradient(circle at 90% 10%,rgba(255,255,255,.14),transparent 25%),linear-gradient(135deg,#064b39,#087f5b 58%,#0a9869);box-shadow:0 12px 30px rgba(6,75,57,.17)}
.frrv-shell .frrv-hero-chip{display:inline-flex;align-items:center;gap:.45rem;border:1px solid rgba(255,255,255,.22);background:rgba(255,255,255,.13);border-radius:100px;padding:.45rem .8rem;color:white;font-weight:600;font-size:.82rem}
.frrv-shell .frrv-hero-card p{color:#d7f4e4!important}
.frrv-shell .frrv-stat-card{cursor:pointer;border:1px solid var(--frrv-border)!important;border-left:5px solid var(--frrv-primary)!important;border-radius:14px;box-shadow:0 5px 16px rgba(6,75,57,.07);transition:transform .2s,box-shadow .2s,background .2s;background:white;overflow:hidden}
.frrv-shell .frrv-stat-card:hover{transform:translateY(-4px);box-shadow:0 12px 24px rgba(6,75,57,.15)}
.frrv-shell .frrv-stat-card.active{background:linear-gradient(130deg,#064b39,#087f5b)!important;border-color:#064b39!important;box-shadow:0 12px 25px rgba(6,75,57,.23)}
.frrv-shell .frrv-stat-card.active h5,.frrv-shell .frrv-stat-card.active .text-muted,.frrv-shell .frrv-stat-card.active .badge{color:white!important}
.frrv-shell .frrv-stat-card.active .badge{background:rgba(255,255,255,.18)!important;border-color:rgba(255,255,255,.2)!important}
.frrv-shell .frrv-avatar{height:52px;width:52px;border-radius:13px;display:inline-flex;align-items:center;justify-content:center;flex-shrink:0;background:#e3f5e9;color:#087f5b}
.frrv-shell .frrv-stat-card.active .frrv-avatar{background:rgba(255,255,255,.2);color:white}
.frrv-shell .frrv-stat-card.warning{border-left-color:#d49d28!important}.frrv-shell .frrv-stat-card.danger{border-left-color:#d65b51!important}
.frrv-shell .frrv-summary-card,.frrv-shell .frrv-table-card,.frrv-shell .frrv-info-card{border:1px solid var(--frrv-border);border-radius:15px;box-shadow:0 8px 23px rgba(6,75,57,.07);overflow:hidden;background:white}
.frrv-shell .frrv-summary-card>.card-header,.frrv-shell .frrv-info-card>.card-header,.frrv-shell .frrv-table-card>.card-header{background:linear-gradient(115deg,#064b39,#087f5b)!important;color:white!important;border:0;padding:16px 20px}
.frrv-shell .frrv-summary-card>.card-header .card-title,.frrv-shell .frrv-info-card>.card-header .card-title,.frrv-shell .frrv-table-card>.card-header .card-title{color:white!important;font-weight:700}
.frrv-shell .frrv-metric{border:1px solid var(--frrv-border);border-radius:12px;background:#fbfefc;box-shadow:0 4px 12px rgba(6,75,57,.05)}
.frrv-shell .frrv-metric h6,.frrv-shell .frrv-metric .text-success{color:#087f5b!important}
.frrv-shell .frrv-progress,.frrv-shell .progress{background:#e2eee7;border-radius:50px;overflow:hidden;min-height:10px}
.frrv-shell .progress-bar.bg-success{background:linear-gradient(90deg,#087f5b,#12a56c)!important}
.frrv-shell .frrv-table{width:100%!important}.frrv-shell .frrv-table thead th{background:#e6f5eb!important;color:#064b39!important;font-weight:700;border-bottom:2px solid #b9dfc7;padding:13px;white-space:nowrap}
.frrv-shell .frrv-table tbody td{padding:12px;border-bottom:1px solid #e4efe8;vertical-align:middle}.frrv-shell .frrv-table tbody tr:hover td{background:#eff9f2!important}
.frrv-shell .btn-success,.frrv-shell .btn-primary{background:linear-gradient(115deg,#087f5b,#0a9869)!important;border-color:#087f5b!important;color:white!important;border-radius:8px}
.frrv-shell .btn-success:hover,.frrv-shell .btn-primary:hover{background:#064b39!important;border-color:#064b39!important}
.frrv-shell .btn-outline-secondary{color:#087f5b;border-color:#9acfb1;border-radius:8px}.frrv-shell .btn-outline-secondary:hover{background:#087f5b;color:white;border-color:#087f5b}
.frrv-shell .frrv-info-card .alert{background:#e9f7ee!important;border-color:#cce8d8!important;color:#24523c!important}
.frrv-shell .dataTables_filter input,.frrv-shell .dataTables_length select{border:1px solid #badcc8;border-radius:8px;padding:7px 10px;outline:0}
.frrv-shell .dataTables_filter input:focus{border-color:#087f5b;box-shadow:0 0 0 3px rgba(8,127,91,.12)}
.frrv-shell .dataTables_wrapper .dataTables_paginate .paginate_button.current{background:#087f5b!important;color:white!important;border-color:#087f5b!important}
.frrv-shell .badge.bg-success,.frrv-shell .text-bg-success{background:#087f5b!important;color:white!important}
#jobDetailsModal .modal-content{border:0;border-radius:15px;overflow:hidden;box-shadow:0 20px 50px rgba(6,75,57,.18)}
#jobDetailsModal .modal-header{background:linear-gradient(115deg,#064b39,#087f5b,#0a9869)!important;color:white}
#jobDetailsModal .modal-title{color:white!important}#jobDetailsModal .modal-body{background:#f7fcf8}#jobDetailsModal .modal-body .card{border:1px solid #cce8d8;border-radius:12px}
#jobDetailsModal .modal-footer{background:#eaf7ee}#jobDetailsModal .btn-secondary{background:#087f5b;border-color:#087f5b}
@media(max-width:767px){.frrv-shell .page-header-breadcrumb{padding:16px}.frrv-shell .frrv-hero-card h1{font-size:1.35rem}.frrv-shell .frrv-table thead th{padding:9px}}
</style>
<div class="main-content app-content frrv-shell">
 <div class="container-fluid page-container">
  <div class="page-header-breadcrumb mb-3">
   <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
    <div><h1 class="page-title fw-bold fs-20 mb-1"><i class="fas fa-chart-line me-2"></i>FRRV Monitoring :: <span>Workflow</span></h1><ol class="breadcrumb mb-0"><li class="breadcrumb-item"><a href="javascript:void(0);">ELIS</a></li><li class="breadcrumb-item active">FRRV Monitoring</li></ol></div>
    <div class="d-flex gap-2 align-items-center"><span class="badge rounded-pill text-bg-success" id="recordCount"><i class="fas fa-file-alt me-1"></i>Total: 0</span><button class="btn btn-success btn-sm" type="button" onclick="loadData()"><i class="fas fa-sync-alt me-1"></i>Refresh</button></div>
   </div>
  </div>
  <div class="card frrv-hero-card mb-4"><div class="card-body p-4 p-xl-5"><div class="d-flex flex-column flex-lg-row justify-content-between align-items-start align-items-lg-center gap-3"><div class="flex-grow-1"><div class="d-flex flex-wrap gap-2 mb-3"><span class="frrv-hero-chip"><i class="fas fa-layer-group"></i>Workflow summary</span><span class="frrv-hero-chip"><i class="fas fa-chart-line"></i>Division progress</span><span class="frrv-hero-chip"><i class="fas fa-table"></i>Job monitoring</span></div><h1 class="fw-bold text-white mb-2">Monitor FRRV progress across SMD, PVLMD and LRD</h1><p class="mb-0" style="max-width:760px">Track first registration workflow progress, division completion and outstanding jobs from one dashboard.</p></div><div class="d-flex flex-wrap gap-2"><span class="frrv-hero-chip"><i class="fas fa-list-check"></i><span id="totalJobs">${total_jobs}</span> jobs</span><span class="frrv-hero-chip"><i class="fas fa-circle-check"></i><span id="fullyCompleted">${fully_completed}</span> completed</span><span class="frrv-hero-chip"><i class="fas fa-hourglass-half"></i><span id="partiallyCompleted">${partially_completed}</span> partial</span></div></div></div></div>
  <div class="row g-4 mb-4" id="statsContainer">
   <div class="col-lg-3 col-md-6"><div class="card custom-card stat-card dashboard-main-card neutral frrv-stat-card active" data-filter="all" role="button" tabindex="0"><div class="card-body"><div class="d-flex align-items-start gap-3"><span class="frrv-avatar neutral"><i class="fas fa-list-check fs-4"></i></span><div><span class="d-block text-muted">Total FRRV Jobs</span><h5 class="fw-bold mb-1" id="totalJobsValueDisplay">${total_jobs}</h5><span class="badge text-bg-light border">All jobs</span></div></div></div></div></div>
   <div class="col-lg-3 col-md-6"><div class="card custom-card stat-card dashboard-main-card success frrv-stat-card" data-filter="Fully Completed" role="button" tabindex="0"><div class="card-body"><div class="d-flex align-items-start gap-3"><span class="frrv-avatar success"><i class="fas fa-circle-check fs-4"></i></span><div><span class="d-block text-muted">Fully Completed</span><h5 class="fw-bold mb-1 text-success" id="fullyCompletedDisplay">${fully_completed}</h5><span class="badge text-bg-success">3 of 3 divisions</span></div></div></div></div></div>
   <div class="col-lg-3 col-md-6"><div class="card custom-card stat-card dashboard-main-card warning frrv-stat-card" data-filter="Partially Completed" role="button" tabindex="0"><div class="card-body"><div class="d-flex align-items-start gap-3"><span class="frrv-avatar warning"><i class="fas fa-hourglass-half fs-4"></i></span><div><span class="d-block text-muted">Partially Completed</span><h5 class="fw-bold mb-1" id="partiallyCompletedDisplay">${partially_completed}</h5><span class="badge text-bg-warning text-dark">1–2 of 3 divisions</span></div></div></div></div></div>
   <div class="col-lg-3 col-md-6"><div class="card custom-card stat-card dashboard-main-card danger frrv-stat-card" data-filter="Not Started" role="button" tabindex="0"><div class="card-body"><div class="d-flex align-items-start gap-3"><span class="frrv-avatar danger"><i class="fas fa-hourglass-start fs-4"></i></span><div><span class="d-block text-muted">Not Started</span><h5 class="fw-bold mb-1 text-danger" id="notStartedDisplay">${not_started}</h5><span class="badge text-bg-danger">0 of 3 divisions</span></div></div></div></div></div>
  </div>
  <div class="row g-4 mb-4"><div class="col-xl-9"><div class="card frrv-summary-card h-100"><div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2"><div class="card-title mb-0">Division Summary</div><span class="badge text-bg-light border">SMD · PVLMD · LRD</span></div><div class="card-body p-3"><div class="row g-3" id="divisionSummaryContainer"><c:forEach var="division" items="${division_summary_details_list}"><div class="col-md-4"><div class="card frrv-metric h-100"><div class="card-body"><div class="d-flex justify-content-between align-items-start mb-2"><div><span class="d-block text-muted small">Division</span><h6 class="fw-bold mb-0"><c:out value="${division.division}"/></h6></div><span class="badge text-bg-light border"><c:out value="${division.division}"/></span></div><div class="d-flex justify-content-between mb-1"><span class="small text-muted">Completed</span><span class="small fw-bold">${division.completed_jobs}</span></div><div class="d-flex justify-content-between mb-2"><span class="small text-muted">Pending</span><span class="small fw-bold">${division.pending_jobs}</span></div><div class="progress frrv-progress"><div class="progress-bar bg-success" role="progressbar" style="width:${division.completion_percentage}%" aria-valuenow="${division.completion_percentage}" aria-valuemin="0" aria-valuemax="100"></div></div><div class="d-flex justify-content-between mt-2"><span class="small text-muted">Total: ${division.total_jobs}</span><span class="small fw-bold text-success">${division.completion_percentage}%</span></div></div></div></div></c:forEach></div></div></div></div>
   <div class="col-xl-3"><div class="card frrv-info-card h-100"><div class="card-header d-flex justify-content-between align-items-center"><div class="card-title mb-0">Quick Guide</div><span class="badge text-bg-light border">Monitor</span></div><div class="card-body"><div class="alert alert-secondary border mb-0 p-3"><div class="d-flex align-items-start"><i class="fas fa-circle-info fa-lg me-2"></i><div><div class="fw-semibold mb-2">FRRV Monitoring Dashboard</div><p class="fs-12 mb-2">Use status cards to filter jobs by completion state.</p><p class="fs-12 mb-2">Division summaries show SMD, PVLMD and LRD progress.</p><p class="fs-12 mb-0">Select View to inspect an individual job.</p></div></div></div><div class="mt-3 d-grid gap-2"><button class="btn btn-success" type="button" onclick="loadData()"><i class="fas fa-sync-alt me-1"></i>Reload FRRV Data</button><button class="btn btn-outline-secondary" type="button" onclick="filterData('all')"><i class="fas fa-layer-group me-1"></i>Show All Jobs</button><button class="btn btn-outline-secondary" type="button" id="btn_load_details_applications"><i class="fas fa-list me-1"></i>Show Details</button></div></div></div></div>
  </div>
  <div class="row"><div class="col-12"><div class="card frrv-table-card mb-4"><div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2"><div class="card-title mb-0"><i class="fas fa-table me-2"></i>FRRV Job Status</div><div class="d-flex align-items-center gap-2"><span class="badge text-bg-light border" id="recordCountTable"><i class="fas fa-file me-1"></i>Total: 0</span><button class="btn btn-sm btn-outline-light" type="button" onclick="loadData()" title="Refresh"><i class="fas fa-sync-alt"></i></button></div></div><div class="card-body p-3"><div class="table-responsive"><table class="table table-striped align-middle frrv-table display" id="frrvTable" width="100%"><thead><tr><th>Job Number</th><th>SMD</th><th>PVLMD</th><th>LRD</th><th>Progress</th><th>Status</th><th>Last Updated</th><th>Action</th></tr></thead><tbody id="frrvTableBody"></tbody></table></div></div></div></div></div>
 </div>
</div>
<script>
(function($){
'use strict';
var frrvRows=[];
var currentFilter='all';
function escapeHtml(v){return $('<div>').text(v==null?'':String(v)).html();}
function parseResponse(response){if(typeof response==='string')return JSON.parse(response);return response;}
function showError(message){if(window.Swal){Swal.fire({title:'FRRV Monitoring',text:message,icon:'error',confirmButtonColor:'#087f5b'});}else{alert(message);}}
function percent(value){var p=Number(value);return isFinite(p)?Math.max(0,Math.min(100,p)):0;}
function isDone(value){return value===true||value===1||value==='1'||value==='true';}
function badge(done){return done?'<span class="badge bg-success">Completed</span>':'<span class="badge bg-warning text-dark">Pending</span>';}
function statusClass(status){return status==='Fully Completed'?'success':status==='Partially Completed'?'warning':'danger';}
function initializeFRRVDataTable(){if(!$.fn.DataTable)return null;if($.fn.DataTable.isDataTable('#frrvTable'))return $('#frrvTable').DataTable();return $('#frrvTable').DataTable({pageLength:10,lengthMenu:[[10,25,50,-1],[10,25,50,'All']],responsive:true,ordering:true,order:[[5,'asc']],columnDefs:[{orderable:false,targets:[1,2,3,4,7]}],language:{search:'Search:',searchPlaceholder:'Search jobs...',lengthMenu:'Show _MENU_ entries',info:'Showing _START_ to _END_ of _TOTAL_ jobs',infoEmpty:'No jobs available',zeroRecords:'No matching jobs found'}});}
window.initializeFRRVDataTable=initializeFRRVDataTable;
function updateCounts(rows){var fully=0,partial=0,notStarted=0;rows.forEach(function(item){var s=item.completion_status;if(s==='Fully Completed')fully++;else if(s==='Partially Completed')partial++;else notStarted++;});$('#totalJobs,#totalJobsValueDisplay').text(rows.length);$('#fullyCompleted,#fullyCompletedDisplay').text(fully);$('#partiallyCompleted,#partiallyCompletedDisplay').text(partial);$('#notStartedDisplay').text(notStarted);}
function drawRows(rows){var table=initializeFRRVDataTable();if(!table)return;table.clear();rows.forEach(function(item){var p=percent(item.completion_percentage),s=item.completion_status||'Not Started',sc=statusClass(s),job=escapeHtml(item.job_number);table.row.add(['<span class="fw-semibold text-success">'+job+'</span>',badge(isDone(item.smd_completed)),badge(isDone(item.pvlmd_completed)),badge(isDone(item.lrd_completed)),'<div class="progress" style="min-width:110px;height:18px"><div class="progress-bar bg-'+sc+'" style="width:'+p+'%">'+p+'%</div></div>','<span class="badge bg-'+sc+'">'+escapeHtml(s)+'</span>',escapeHtml(item.last_updated||'N/A'),'<button class="btn btn-sm btn-success view-details" type="button" data-job="'+job+'"><i class="fas fa-eye me-1"></i>View</button>']);});table.draw();$('#recordCount,#recordCountTable').html('<i class="fas fa-file-alt me-1"></i>Total: '+rows.length);}
window.filterData=function(status){currentFilter=status||'all';$('.frrv-stat-card').removeClass('active').filter(function(){return $(this).attr('data-filter')===currentFilter;}).addClass('active');drawRows(currentFilter==='all'?frrvRows:frrvRows.filter(function(item){return item.completion_status===currentFilter;}));};
window.loadData=function(){var btn=$('#btn_load_details_applications');btn.prop('disabled',true).html('<span class="spinner-border spinner-border-sm me-1"></span>Loading...');$.ajax({type:'POST',url:'Case_Management_Serv',data:{request_type:'get_frrv_jobs_status_json',division:localStorage.getItem('division')||''},cache:false,success:function(response){try{var parsed=parseResponse(response);var rows=Array.isArray(parsed)?parsed:(parsed&&Array.isArray(parsed.data)?parsed.data:null);if(!rows)throw new Error('Invalid FRRV response format');frrvRows=rows;updateCounts(rows);window.filterData(currentFilter);}catch(e){showError(e.message||'Unable to process FRRV records');}},error:function(){showError('Unable to load FRRV jobs. Please try again.');},complete:function(){btn.prop('disabled',false).html('<i class="fas fa-list me-1"></i>Show Details');}});};
window.viewJobDetails=function(jobNumber){$.ajax({type:'POST',url:'Case_Management_Serv',data:{request_type:'get_frrv_job_details',job_number:jobNumber},success:function(response){try{var data=parseResponse(response);window.showJobDetailsModal(data&&data.data?data.data:data);}catch(e){showError('Could not read job details.');}},error:function(){showError('Could not load job details.');}});};
window.showJobDetailsModal=function(job){job=job||{};function divisionCard(name,completed,status){return '<div class="col-md-4"><div class="card h-100"><div class="card-body text-center"><h6 class="text-success fw-bold">'+name+'</h6><span class="badge '+(isDone(completed)?'bg-success':'bg-warning text-dark')+'">'+escapeHtml(status||'Not Started')+'</span></div></div></div>';}$('#jobDetailsModal').remove();var html='<div class="modal fade" id="jobDetailsModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content"><div class="modal-header"><h5 class="modal-title text-white"><i class="fas fa-info-circle me-2"></i>FRRV Details - '+escapeHtml(job.job_number)+'</h5><button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body"><div class="row g-3">'+divisionCard('SMD',job.smd_completed,job.smd_status)+divisionCard('PVLMD',job.pvlmd_completed,job.pvlmd_status)+divisionCard('LRD',job.lrd_completed,job.lrd_status)+'</div><div class="mt-3 text-center"><small class="text-muted">Last Updated: '+escapeHtml(job.last_updated||'N/A')+'</small></div></div><div class="modal-footer"><button class="btn btn-secondary" type="button" data-bs-dismiss="modal">Close</button></div></div></div></div>';$('body').append(html);if(window.bootstrap&&bootstrap.Modal){bootstrap.Modal.getOrCreateInstance(document.getElementById('jobDetailsModal')).show();}else{$('#jobDetailsModal').modal('show');}};
$(function(){initializeFRRVDataTable();$('.frrv-stat-card').on('click keydown',function(e){if(e.type==='keydown'&&e.key!=='Enter'&&e.key!==' ')return;e.preventDefault();window.filterData($(this).attr('data-filter'));});$('#btn_load_details_applications').on('click',window.loadData);$('#frrvTable').on('click','.view-details',function(){window.viewJobDetails($(this).attr('data-job'));});$('#frrvTable').on('click','.view-progress',function(){window.location.href='frrv_progress.jsp?job='+encodeURIComponent($(this).attr('data-job'));});});
})(jQuery);
</script>

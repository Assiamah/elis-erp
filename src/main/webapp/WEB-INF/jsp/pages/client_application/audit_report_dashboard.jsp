<script>
document.addEventListener('DOMContentLoaded',function(){
 document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(function(el){if(window.bootstrap&&bootstrap.Tooltip)new bootstrap.Tooltip(el);});
 var searchInput=document.getElementById('userReportSearch'),regionSelect=document.getElementById('userReportRegion'),designationSelect=document.getElementById('userReportDesignation'),sortSelect=document.getElementById('userReportSort'),pageSizeSelect=document.getElementById('userReportPageSize'),clearButton=document.getElementById('clearUserReportFilters'),reportList=document.getElementById('userReportList'),resultCount=document.getElementById('userReportResultCount'),emptyState=document.getElementById('userReportEmptyState'),pagination=document.getElementById('userReportPagination'),statusBox=document.getElementById('userReportStatus');
 var allUserReportRows=[],loadedDateRange='',currentUserReportPage=1;
 reportList.innerHTML='';
 function esc(v){return String(v==null?'':v).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#039;');}
 function initials(n){return String(n||'Unknown User').trim().split(/\s+/).slice(0,2).map(function(s){return s.charAt(0).toUpperCase();}).join('');}
 function getLogType(t){return {'New Transaction Added':'Add Transaction','New Parcel Added':'Add Parcel','Parcel Update':'Update Parcel','Transaction Update':'Upate Transaction','New Plotting Created':'Plot Parcel','User Update':'Upate User','New User Added':'Add User','Parcel Deleted':'Delete Parcel','Menu Assignment':'Menu-Template Assignment'}[t]||t;}
 function populateFilter(select,label,values){var old=select.value;select.innerHTML='<option value="">'+label+'</option>';Array.from(new Set(values.filter(Boolean))).sort(function(a,b){return a.localeCompare(b);}).forEach(function(v){var opt=document.createElement('option');opt.value=v;opt.textContent=v;select.appendChild(opt);});select.value=old;}
 function renderCards(rows){reportList.innerHTML=rows.map(function(u){var name=String(u.user_name||'Unknown User').trim(),uid=String(u.user_id||''),dep=String(u.department||'Not specified').trim(),region=String(u.region||'Not specified').trim(),desig=String(u.designation||'Not specified').trim(),division=String(u.division||'Not specified').trim(),total=Number(u.total_activities)||0,activities=Array.isArray(u.activity_types)?u.activity_types:[];
 var tiles=activities.map(function(a){var type=String(a.activity_type||'Other').trim(),logtype=getLogType(type),count=Number(a.count)||0;return '<div class="col-6 col-md-4 col-xl-3"><a href="javascript:void(0)" class="user-log-type d-block text-decoration-none" id="view_activities_By_usser" data-id="'+esc(uid)+'" data-name_full="'+esc(name)+'" data-actv="'+esc(type)+'" data-logt="'+esc(logtype)+'"><div class="small text-muted">'+esc(type)+'</div><div class="user-log-type-count">'+count.toLocaleString()+'</div><small class="text-primary">View details <i class="fas fa-arrow-right ms-1"></i></small></a></div>';}).join('');
 return '<div class="card user-report-card user-report-item mb-3" data-name="'+esc(name)+'" data-search="'+esc((name+' '+uid+' '+dep+' '+division).toLowerCase())+'" data-region="'+esc(region)+'" data-designation="'+esc(desig)+'" data-total="'+total+'"><div class="card-body p-4"><div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-3"><div class="d-flex align-items-center"><div class="user-report-avatar me-3">'+esc(initials(name))+'</div><div><h4 class="h6 fw-bold mb-1">'+esc(name)+'</h4><div class="small text-muted">'+esc(desig)+'</div><div class="small text-muted"><i class="fas fa-map-marker-alt me-1"></i>'+esc(region)+' · '+esc(dep)+' · '+esc(division)+'</div></div></div><div class="text-end"><div class="h4 fw-bold text-primary mb-0">'+total.toLocaleString()+'</div><small class="text-muted">total activities</small></div></div><div class="row g-2">'+(tiles||'<div class="col-12 text-muted small">No grouped log types returned.</div>')+'</div></div></div>';}).join('');}
 function renderPagination(total,size){var pages=Math.ceil(total/size);if(pages<=1){pagination.innerHTML='';return;}var first=Math.max(1,currentUserReportPage-2),last=Math.min(pages,currentUserReportPage+2);if(currentUserReportPage<=3)last=Math.min(pages,5);if(currentUserReportPage>=pages-2)first=Math.max(1,pages-4);var s='<ul class="pagination pagination-sm mb-0"><li class="page-item '+(currentUserReportPage===1?'disabled':'')+'"><button class="page-link" type="button" data-page="'+(currentUserReportPage-1)+'">&lsaquo;</button></li>';if(first>1){s+='<li class="page-item"><button class="page-link" data-page="1">1</button></li>';if(first>2)s+='<li class="page-item disabled"><span class="page-link">…</span></li>';}for(var i=first;i<=last;i++)s+='<li class="page-item '+(i===currentUserReportPage?'active':'')+'"><button class="page-link" type="button" data-page="'+i+'">'+i+'</button></li>';if(last<pages){if(last<pages-1)s+='<li class="page-item disabled"><span class="page-link">…</span></li>';s+='<li class="page-item"><button class="page-link" data-page="'+pages+'">'+pages+'</button></li>';}pagination.innerHTML=s+'<li class="page-item '+(currentUserReportPage===pages?'disabled':'')+'"><button class="page-link" type="button" data-page="'+(currentUserReportPage+1)+'">&rsaquo;</button></li></ul>';}
 function updateReport(){var q=searchInput.value.trim().toLowerCase(),r=regionSelect.value,d=designationSelect.value,rows=allUserReportRows.filter(function(u){return(!q||[u.user_name,u.user_id,u.department,u.division].join(' ').toLowerCase().indexOf(q)!==-1)&&(!r||String(u.region||'').trim()===r)&&(!d||String(u.designation||'').trim()===d);});rows.sort(function(a,b){return sortSelect.value==='name'?String(a.user_name||'').localeCompare(String(b.user_name||'')):(Number(b.total_activities)||0)-(Number(a.total_activities)||0);});var size=Number(pageSizeSelect.value)||10;currentUserReportPage=Math.min(currentUserReportPage,Math.max(1,Math.ceil(rows.length/size)));var start=(currentUserReportPage-1)*size,shown=rows.slice(start,start+size);renderCards(shown);renderPagination(rows.length,size);resultCount.textContent=rows.length?'Showing '+(start+1)+'–'+(start+shown.length)+' of '+rows.length+' users':'Showing 0 users';emptyState.classList.toggle('d-none',rows.length!==0);}
 function status(kind,message,spinner){statusBox.className='alert alert-'+kind+' d-flex align-items-center mb-4';statusBox.innerHTML=(spinner?'<span class="spinner-border spinner-border-sm me-2"></span>':'<i class="fas fa-info-circle me-2"></i>')+'<div>'+esc(message)+'</div>';}
 function loadReport(force){var start=document.getElementById('start_date').value||document.getElementById('datefrom').value,end=document.getElementById('end_date').value||document.getElementById('dateto').value,range=start+'|'+end;if(!start||!end){status('warning','Select both dates under Activity Overview first.');return;}if(!force&&loadedDateRange===range&&allUserReportRows.length){updateReport();return;}status('info','Loading user activity report...',true);reportList.innerHTML='';pagination.innerHTML='';resultCount.textContent='Loading users...';emptyState.classList.add('d-none');if(!window.jQuery){status('danger','jQuery is required to load this report.');return;}$.ajax({type:'POST',url:'audit_reporting',data:{request_type:'get_advanced_activity_logs_summary_by_user',start_date_ar:start,end_date_ar:end},cache:false,success:function(response){try{var result=typeof response==='string'?JSON.parse(response):response;if(!result||result.success!==true)throw new Error(result&&result.message||'Unable to load the report.');allUserReportRows=Array.isArray(result.data)?result.data:[];loadedDateRange=range;currentUserReportPage=1;populateFilter(regionSelect,'All regions',allUserReportRows.map(function(u){return String(u.region||'').trim();}));populateFilter(designationSelect,'All designations',allUserReportRows.map(function(u){return String(u.designation||'').trim();}));status('success','Report loaded for '+start+' to '+end+'.');updateReport();}catch(e){allUserReportRows=[];reportList.innerHTML='';pagination.innerHTML='';resultCount.textContent='No users loaded';status('danger',e.message);}},error:function(){allUserReportRows=[];reportList.innerHTML='';pagination.innerHTML='';resultCount.textContent='No users loaded';status('danger','Could not load the user activity report. Please try again.');}});}
 [searchInput,regionSelect,designationSelect,sortSelect,pageSizeSelect].forEach(function(el){el.addEventListener(el===searchInput?'input':'change',function(){currentUserReportPage=1;updateReport();});});clearButton.addEventListener('click',function(){searchInput.value='';regionSelect.value='';designationSelect.value='';sortSelect.value='activity';pageSizeSelect.value='10';currentUserReportPage=1;updateReport();});pagination.addEventListener('click',function(e){var btn=e.target.closest('[data-page]');if(!btn||btn.closest('.page-item').classList.contains('disabled'))return;currentUserReportPage=Number(btn.dataset.page)||1;updateReport();document.getElementById('report-by-user-pane').scrollIntoView({behavior:'smooth',block:'start'});});document.getElementById('report-by-user-tab').addEventListener('shown.bs.tab',function(){loadReport(false);});document.getElementById('dateto').addEventListener('change',function(){if(document.getElementById('report-by-user-tab').classList.contains('active'))loadReport(true);});
});
</script>

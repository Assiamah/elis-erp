<c:if test="${active_case_objection > 0 && business_process_sub_name != 'APPLICATION FOR OBJECTION' && job_purpose != 'Update Objection Status'}"><script>document.addEventListener('DOMContentLoaded',function(){Swal.fire({title:'Application Objected',text:'There are ${active_case_objection} objection(s) recorded against this application.',icon:'error',confirmButtonText:'View Details',confirmButtonColor:'#dc3545'}).then(function(r){if(r.isConfirmed){var el=document.getElementById('collapseObjections');if(el&&typeof bootstrap!=='undefined')bootstrap.Collapse.getOrCreateInstance(el).show();}});});</script></c:if>
<script>
function editStep(stepId){alert('Editing step with ID: '+stepId);}
function deleteStep(stepId){if(confirm('Are you sure you want to delete the step with ID: '+stepId+'?'))alert('Deleted step with ID: '+stepId);}
function reviewStep(bse_id,job_number){
 Swal.fire({title:'Confirm Approval',text:'Are you sure you want to approve this step?',icon:'warning',showCancelButton:true,confirmButtonColor:'#087b58',cancelButtonColor:'#d33',confirmButtonText:'Yes, approve it!',reverseButtons:true}).then(function(result){
 if(!result.isConfirmed)return;
 if(!bse_id||!job_number){Swal.fire('Error!','Missing step or job number.','error');return;}
 Swal.fire({title:'Processing...',text:'Please wait while we approve the step',allowOutsideClick:false,didOpen:function(){Swal.showLoading();}});
 $.ajax({type:'POST',url:'Case_Management_Serv',data:{request_type:'select_review_baby_steps_check_for_completion',bse_id:parseInt(bse_id,10),job_number:job_number},cache:false,success:function(response){
 if(response==='session expired'){Swal.fire('Error!','Your session has expired. Log out and log in again.','error');return;}
 var r;try{r=typeof response==='string'?JSON.parse(response):response;}catch(e){Swal.fire('Error!','Unexpected server response.','error');return;}
 Swal.close();if(!r.success){Swal.fire('Failed!',r.msg||'Approval failed.','error');return;}
 if(r.operation_type==='lrd_initial_approval'&&r.msg==='Application has been move to Awaiting Punlication'){
 Swal.fire({title:'Success!',html:'<p>Application processing has been completed.</p><div class="alert alert-info text-start">Publication requires 14 days. The application remains in <b>Awaiting Publication</b> and will move to <b>Completed Request</b> after the publication period.</div>',icon:'success',confirmButtonText:'Proceed',confirmButtonColor:'#087b58',allowOutsideClick:false}).then(function(){window.location.href='/case_movement_module';});
 }else{Swal.fire({title:'Success!',text:'Step approved successfully',icon:'success',timer:2000,timerProgressBar:true,willClose:function(){location.reload();}});}
 },error:function(){Swal.fire('Error!','An error occurred while processing your request.','error');}});
 });
}
document.addEventListener('DOMContentLoaded',function(){
 if(typeof ol==='undefined'||typeof proj4==='undefined'||typeof getGeoServerEndPoint!=='function')return;
 var endpoint=getGeoServerEndPoint()+'/geoserver/csau_geospatial/wms';
 function wms(layer,title,visible){return new ol.layer.Tile({title:title,visible:visible!==false,source:new ol.source.TileWMS({url:endpoint,params:{LAYERS:'csau_geospatial:'+layer,TILED:true},serverType:'geoserver',transition:0})});}
 proj4.defs('EPSG:2136','+proj=tmerc +lat_0=4.666666666666667 +lon_0=-1 +k=0.99975 +x_0=274319.7391633579 +y_0=0 +a=6378300 +b=6356751.689189189 +towgs84=-199,32,322,0,0,0,0 +to_meter=0.3047997101815088 +no_defs');
 ol.proj.setProj4(proj4);
 var projObj=new ol.proj.Projection({code:'EPSG:2136',extent:[80935.4497355444,1209.0295731349593,1711780.3060929566,2358523.124783509],units:'ft',axisOrientation:'enu',global:false,worldExtent:[-3.79,1.4,2.1,11.16],getPointResolution:function(r){return r;}});
 var controls=ol.control.defaults().extend([new ol.control.LayerSwitcher(),new ol.control.OverviewMap(),new ol.control.ZoomSlider(),new ol.control.Attribution(),new ol.control.MousePosition(),new ol.control.ZoomToExtent(),new ol.control.FullScreen()]);
 var map=new ol.Map({target:'parcelMap',controls:controls,renderer:'canvas',layers:[new ol.layer.Tile({source:new ol.source.OSM()})],view:new ol.View({projection:projObj,extent:projObj.getExtent(),center:[1187433.58822084,327091.107070208],zoom:12})});
 var satellite=new ol.layer.Tile({title:'Google Satellite & Roads',visible:false,source:new ol.source.XYZ({url:'https://mt0.google.com/vt/lyrs=y&hl=en&x={x}&y={y}&z={z}&s=Ga'})});
 map.addLayer(satellite);map.addLayer(wms('district','Registration District',false));map.addLayer(wms('lc_spatial_objects','LRD Parcels Layer'));map.addLayer(wms('lc_spatial_objects_undergoing_registration','Under Registration Layer'));
 var vector=new ol.layer.Vector({source:new ol.source.Vector(),style:new ol.style.Style({stroke:new ol.style.Stroke({color:'#ff0000',width:2}),fill:new ol.style.Fill({color:'rgba(255,0,0,0.2)'})})});map.addLayer(vector);
 var wkt=document.getElementById('lc_fr_bl_wkt_polygon').value;
 if(wkt&&wkt.trim()){try{var features=new ol.format.WKT().readFeatures(wkt);vector.getSource().addFeatures(features);var extent=vector.getSource().getExtent();if(extent.every(Number.isFinite))map.getView().fit(extent,{size:map.getSize(),maxZoom:16,padding:[20,20,20,20]});}catch(err){console.warn('Unable to display parcel WKT:',err);}}
 document.getElementById('collapseMap').addEventListener('shown.bs.collapse',function(){map.updateSize();});
});
</script>

ry.case_number}" data-reasons="${query.reasons}" data-remarks="${query.remarks}" data-general_reason="${query.query_general_reason}" data-query_response="${query.query_response}" data-status="${query.status}" data-created_by="${query.created_by}" data-created_date="${query.created_date}" data-modified_by="${query.modified_by}" data-modified_date="${query.modified_date}" data-attachment_required="${query.attachment_required}"><i class="bi bi-pencil"></i></button></td></tr></c:forEach></tbody></table></div></div></div></div>

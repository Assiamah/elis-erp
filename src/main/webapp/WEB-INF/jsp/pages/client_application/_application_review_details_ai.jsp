<div class="col-md-4"><div class="data-label">Document Date</div><div class="data-value">${empty date_of_document ? "--" : date_of_document}</div></div>
<div class="col-md-4"><div class="data-label">Registration Date</div><div class="data-value">${empty date_of_registration ? "--" : date_of_registration}</div></div>
<div class="col-md-4"><div class="data-label">Type of Interest</div><div class="data-value">${empty type_of_interest ? "--" : type_of_interest}</div></div>
<div class="col-md-4"><div class="data-label">Type of Use</div><div class="data-value">${empty type_of_use ? "--" : type_of_use}</div></div>
<div class="col-md-4"><div class="data-label">Term</div><div class="data-value">${empty term ? "--" : term}</div></div>
<div class="col-md-4"><div class="data-label">Option for Renewal</div><div class="data-value">${empty renewal_term ? "--" : renewal_term}</div></div>
<div class="col-md-4"><div class="data-label">Commencement Date</div><div class="data-value">${empty commencement_date ? "--" : commencement_date}</div></div>
<div class="col-md-4"><div class="data-label">Assessed Value</div><div class="data-value">${empty assessed_value ? "--" : assessed_value}</div></div>
<div class="col-md-4"><div class="data-label">Stamp Duty Payable</div><div class="data-value">${empty stamp_duty_payable ? "--" : stamp_duty_payable}</div></div>
<div class="col-md-4"><div class="data-label">Consideration in Document</div><div class="data-value">${empty consideration_fee ? "--" : consideration_fee}</div></div>
<div class="col-md-4"><div class="data-label">Consideration Currency</div><div class="data-value">${empty consideration_fee_currency ? "--" : consideration_fee_currency}</div></div>
<div class="col-md-4"><div class="data-label">Adopted Currency Rate</div><div class="data-value">${empty consideration_fee_adopted_rate ? "--" : consideration_fee_adopted_rate}</div></div>
<div class="col-md-4"><div class="data-label">Certificate Number</div><div class="data-value">${empty certificate_number ? "--" : certificate_number}</div></div>
<div class="col-md-4"><div class="data-label">Publication Date</div><div class="data-value">${empty publicity_date ? "--" : publicity_date}</div></div>
<div class="col-md-4"><div class="data-label">Date of Issue</div><div class="data-value">${empty date_of_issue ? "--" : date_of_issue}</div></div>
<div class="col-md-4"><div class="data-label">Registered Number</div><div class="data-value">${empty registered_number ? "--" : registered_number}</div></div>
<div class="col-md-4"><div class="data-label">Volume Number</div><div class="data-value">${empty volume_number ? "--" : volume_number}</div></div>
<div class="col-md-4"><div class="data-label">Folio Number</div><div class="data-value">${empty folio_number ? "--" : folio_number}</div></div>
<div class="col-md-4"><div class="data-label">Interest Number</div><div class="data-value">${empty interest_number ? "--" : interest_number}</div></div>
<div class="col-md-4"><div class="data-label">Sub-Interest Number</div><div class="data-value">${empty sub_interest_number ? "--" : sub_interest_number}</div></div>
<c:if test="${not empty business_process_sub_name and fn:containsIgnoreCase(business_process_sub_name, 'deed')}">
<div class="col-md-4"><div class="data-label">File Number</div><div class="data-value">${empty file_number ? "--" : file_number}</div></div>
<div class="col-md-4"><div class="data-label">Serial Number</div><div class="data-value">${empty ls_number ? "--" : ls_number}</div></div>
<div class="col-md-4"><div class="data-label">Deed Number</div><div class="data-value">${empty deed_number ? "--" : deed_number}</div></div>
</c:if></div></div></div></div></div></div>
<div class="card mb-4"><div class="card-header section-header d-flex justify-content-between align-items-center"><div class="d-flex align-items-center gap-3"><span class="avatar avatar-md rounded-circle"><i class="bi bi-clipboard-check fs-5"></i></span><div><h6 class="mb-1 fw-bold">Process Status &amp; Actions</h6><p class="mb-0 small">${job_number} - ${ar_name}</p></div></div><div class="d-flex align-items-center gap-2 flex-wrap"><button class="btn btn-danger btn-sm ${rq_id == null || review_type == 'SpecificWorkRequest' ? 'd-none' : ''}" data-job_number="${job_number}" data-ar_name="${ar_name}" data-req_id="${rq_id}" data-business_process_sub_name="${business_process_sub_name}" onclick="requestAdditionalInput(this)">Additional Request</button><button class="btn btn-info btn-sm ${rq_id == null ? 'd-none' : ''}" data-job_number="${job_number}" data-ar_name="${ar_name}" data-req_id="${rq_id}" data-business_process_sub_name="${business_process_sub_name}" onclick="showArchiveConfirmation(this)">Complete Request</button><button class="btn btn-warning btn-sm ${review_type == 'SpecificWorkRequest' ? 'd-none' : ''}" data-bs-toggle="modal" data-bs-target="#askForPurposeOfBatching" data-job_number="${job_number}" data-ar_name="${ar_name}" data-req_id="${rq_id}" data-business_process_sub_name="${business_process_sub_name}">Add to Batch</button></div></div><div class="card-body p-4">
<c:forEach items="${baby_step_milestone_list}" var="milestone"><c:if test="${milestone.mile_stone_status == 'Ongoing'}"><div class="alert alert-info mb-3"><small>Current Milestone</small><div><span class="badge bg-warning text-dark me-2">Ongoing</span>${milestone.milestone_description}</div></div></c:if></c:forEach>
<div class="process-timeline"><c:forEach var="babyStep" items="${active_digital_workflow_step_list}" varStatus="loop"><div class="process-step-card" data-status="${babyStep.bse_status.toLowerCase()}"><div class="d-flex align-items-start gap-3 mb-3"><span class="avatar avatar-md rounded-circle ${babyStep.bse_status == 'Completed' ? 'bg-success text-white' : babyStep.bse_status == 'Ongoing' ? 'bg-warning text-dark' : 'bg-danger text-white'}">${loop.index + 1}</span><div class="flex-grow-1"><div class="d-flex align-items-start justify-content-between flex-wrap gap-2"><div><h6 class="fw-bold mb-2">${babyStep.bse_description}</h6><span class="badge ${babyStep.bse_status == 'Completed' ? 'bg-success' : babyStep.bse_status == 'Ongoing' ? 'bg-warning text-dark' : 'bg-danger'}">${babyStep.bse_status}</span><small class="text-muted ms-2">Started: ${empty babyStep.start_date ? '--' : babyStep.start_date}</small></div><button class="btn btn-sm btn-outline-info" data-bs-toggle="modal" data-bs-target="#${babyStep.bse_description_key}" data-bs-id="${babyStep.bse_id}" data-bse-id="${babyStep.bse_id}" data-bs-desc="${babyStep.bse_description}" data-bs-username="${babyStep.username}" data-bs-date="${babyStep.date}" data-bs-time="${babyStep.time}" ${active_case_objection > 0 && business_process_sub_name != 'APPLICATION FOR OBJECTION' && job_purpose != 'Update Objection Status' ? 'disabled' : ''} ${babyStep.bse_status == 'Pending' || babyStep.bse_status == 'Completed' ? 'disabled' : ''}><i class="bi bi-eye"></i> Details</button></div></div></div>
<div class="step-details"><div class="d-flex justify-content-between align-items-center flex-wrap gap-3"><div class="btn-group"><button class="btn btn-sm btn-success" onclick="reviewStep('${babyStep.bse_id}','${job_number}')" ${active_case_objection > 0 && business_process_sub_name != 'APPLICATION FOR OBJECTION' && job_purpose != 'Update Objection Status' || babyStep.bse_status == 'Pending' || babyStep.bse_status == 'Completed' ? 'disabled' : ''}><i class="bi bi-check-circle"></i> Approve</button><button class="btn btn-sm btn-primary btn_send_request" id="btnAddRequest" data-job_number="${job_number}" data-ar_name="${ar_name}" data-business_process_sub_name="${business_process_sub_name}" data-locality="${locality}" data-bs-desc="${babyStep.bse_description}" ${active_case_objection > 0 && business_process_sub_name != 'APPLICATION FOR OBJECTION' && job_purpose != 'Update Objection Status' || babyStep.bse_status == 'Pending' || babyStep.bse_status == 'Completed' ? 'disabled' : ''}><i class="bi bi-send"></i> Send Request</button><button class="btn btn-sm btn-warning" data-bs-toggle="modal" data-bs-target="#newQueryModal" data-job_number="${job_number}" data-ar_name="${ar_name}" data-business_process_sub_name="${business_process_sub_name}" data-locality="${locality}" ${active_case_objection > 0 && business_process_sub_name != 'APPLICATION FOR OBJECTION' && job_purpose != 'Update Objection Status' || babyStep.bse_status == 'Pending' || babyStep.bse_status == 'Completed' ? 'disabled' : ''}><i class="bi bi-question-circle"></i> Query</button></div><div class="d-flex gap-3"><div><small class="text-muted d-block">Approved By</small><strong>${empty babyStep.completed_by || babyStep.completed_by == 'null, null' ? 'Pending' : babyStep.completed_by}</strong></div><div><small class="text-muted d-block">Approval Date</small><strong>${empty babyStep.complete_by_date ? 'Not approved' : babyStep.complete_by_date}</strong></div></div></div></div><c:if test="${!loop.last}"><div class="timeline-connector"></div></c:if></div></c:forEach></div>
<c:if test="${empty active_digital_workflow_step_list}"><div class="text-center py-5 text-muted"><i class="bi bi-clipboard-x display-4"></i><h6>No Process Steps Found</h6><p>No active process steps are available for this application.</p></div></c:if>
<div class="row border-top pt-3"><c:set var="completedCount" value="0"/><c:set var="ongoingCount" value="0"/><c:set var="pendingCount" value="0"/><c:forEach items="${active_digital_workflow_step_list}" var="step"><c:if test="${step.bse_status == 'Completed'}"><c:set var="completedCount" value="${completedCount + 1}"/></c:if><c:if test="${step.bse_status == 'Ongoing'}"><c:set var="ongoingCount" value="${ongoingCount + 1}"/></c:if><c:if test="${step.bse_status == 'Pending'}"><c:set var="pendingCount" value="${pendingCount + 1}"/></c:if></c:forEach><div class="col-md-4"><span class="badge bg-success">Completed</span> <strong>${completedCount}</strong></div><div class="col-md-4"><span class="badge bg-warning text-dark">In Progress</span> <strong>${ongoingCount}</strong></div><div class="col-md-4"><span class="badge bg-danger">Pending</span> <strong>${pendingCount}</strong></div></div></div></div></div>

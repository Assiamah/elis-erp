<style>
.elis-application-details{--eg:#087b58;--dark:#07543f;--soft:#eaf8f0;--border:#c8e8d5;--gradient:linear-gradient(115deg,#07543f 0%,#087b58 55%,#13a16e 100%)}
.elis-application-details .page-header-breadcrumb{background:var(--gradient);border-radius:13px;padding:23px 27px;box-shadow:0 9px 24px #07543f24}
.elis-application-details .page-header-breadcrumb .page-title,.elis-application-details .page-header-breadcrumb .breadcrumb-item,.elis-application-details .page-header-breadcrumb .breadcrumb-item a{color:white!important}
.elis-application-details .page-header-breadcrumb .breadcrumb-item+.breadcrumb-item:before{color:#ffffffb8}
.elis-application-details .card{border-radius:12px;border-color:var(--border);box-shadow:0 3px 12px #07543f0c}
.elis-application-details .section-header{background:var(--gradient)!important;color:#fff!important;border:0;padding:15px 19px}
.elis-application-details .section-header h6,.elis-application-details .section-header p,.elis-application-details .section-header .card-title,.elis-application-details .section-header i{color:#fff!important}
.elis-application-details .section-header .avatar{background:#ffffff30!important;color:white!important}
.elis-application-details .section-header .btn-outline-dark{border-color:#ffffffa8;color:white}
.elis-application-details .section-header .btn-outline-dark:hover{background:white;color:var(--dark)}
.elis-application-details .btn-primary,.elis-application-details .btn-info:not(.view-minute-btn){background:var(--eg)!important;border-color:var(--eg)!important;color:#fff!important}
.elis-application-details .btn-primary:hover,.elis-application-details .btn-info:not(.view-minute-btn):hover{background:var(--dark)!important;border-color:var(--dark)!important}
.elis-application-details .btn-outline-primary,.elis-application-details .btn-outline-info{color:var(--eg)!important;border-color:var(--eg)!important}
.elis-application-details .btn-outline-primary:hover,.elis-application-details .btn-outline-info:hover{background:var(--eg)!important;color:white!important}
.elis-application-details .badge.bg-primary{background:var(--eg)!important}
.elis-application-details .table{font-size:12px}.elis-application-details .table thead th{background:var(--dark)!important;color:white!important;border-color:var(--eg)!important;padding:10px;white-space:nowrap}
.elis-application-details .table tbody td{padding:9px;vertical-align:middle}.elis-application-details .table-hover tbody tr:hover{background:#edf9f2!important}
.elis-application-details #sidebarAccordion{border:1px solid var(--border);border-radius:12px;overflow:hidden}
.elis-application-details #sidebarAccordion .accordion-item{border-color:#d9eee2}
.elis-application-details #sidebarAccordion .accordion-button{background:#eff9f3;color:var(--dark);font-weight:650;box-shadow:none}
.elis-application-details #sidebarAccordion .accordion-button:not(.collapsed){background:var(--gradient);color:white}
.elis-application-details #sidebarAccordion .accordion-button:not(.collapsed):after{filter:brightness(0) invert(1)}
.elis-application-details #sidebarAccordion .accordion-button:focus{box-shadow:0 0 0 3px #087b582b}
.elis-application-details #parcelMap{border:1px solid var(--border);border-radius:10px;overflow:hidden}
.elis-application-details .process-step-card{position:relative;padding:1.5rem;border:1px solid #e4ebe7;border-radius:12px;margin-bottom:1.5rem;transition:box-shadow .2s}
.elis-application-details .process-step-card:hover{box-shadow:0 6px 20px #07543f18}
.elis-application-details .process-step-card[data-status=completed]{border-left:5px solid #198754;background:#f2fbf5}
.elis-application-details .process-step-card[data-status=ongoing]{border-left:5px solid #ffc107;background:#fffdf3}
.elis-application-details .process-step-card[data-status=pending]{border-left:5px solid #dc3545;background:#fff8f8}
.elis-application-details .step-details{border-left:2px dashed #b9dec8;padding-left:1.5rem;margin-left:1.5rem}
.elis-application-details .timeline-connector{position:absolute;bottom:-1.5rem;left:2rem;height:1.5rem;width:2px;background:#9fd1b4}
.elis-application-details .avatar{display:inline-flex;align-items:center;justify-content:center}.elis-application-details .avatar-md{width:48px;height:48px}.elis-application-details .avatar-sm{width:36px;height:36px}
.elis-application-details .objected-application-alert{border:1px solid #dc354533;border-left:5px solid #dc3545;background:#fff4f4;border-radius:12px}
.elis-application-details .objected-icon{width:44px;height:44px;background:#dc3545;color:white}
.elis-application-details .objected-status-pill{display:inline-flex;gap:.4rem;background:#dc35451a;color:#b02a37;padding:.4rem .8rem;border-radius:30px;font-weight:700}
.elis-application-details .alert-info{background:var(--soft);border-left:4px solid var(--eg)!important;color:var(--dark)}
.elis-application-details .form-control:focus,.elis-application-details .form-select:focus{border-color:var(--eg);box-shadow:0 0 0 .2rem #087b5825}
.elis-application-details .scrollable-col{overflow-y:auto;max-height:100%}
.elis-application-details .process-action-buttons{flex-wrap:wrap}.elis-application-details .process-action-buttons .btn{white-space:nowrap}
.elis-application-details .data-label{color:#61766a;font-size:12px;margin-bottom:3px}.elis-application-details .data-value{color:#203f31;font-weight:600;overflow-wrap:anywhere}
@media(max-width:991px){.elis-application-details .scrollable-col{max-height:none;overflow:visible}.elis-application-details .process-step-card{padding:1rem}.elis-application-details .step-details{margin-left:.5rem;padding-left:1rem}.elis-application-details .section-header{flex-wrap:wrap;gap:12px}}
</style>
<div class="main-content app-content elis-application-details"><div class="container-fluid page-container">
<div class="page-header-breadcrumb mb-3"><div class="d-flex align-items-center justify-content-between flex-wrap gap-2"><h1 class="page-title fw-bold fs-18 mb-0">Application Details</h1><ol class="breadcrumb mb-0"><li class="breadcrumb-item"><a href="javascript:void(0);">ELIS</a></li><li class="breadcrumb-item active text-white">Application Details</li></ol></div></div>
<div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4"><div class="d-flex align-items-center gap-3"><span class="badge bg-primary fs-6">${job_number}</span><h5 class="mb-0">${ar_name}</h5></div><button type="button" onclick="history.go(-1)" class="btn btn-outline-primary"><i class="bi bi-arrow-left me-2"></i>Back to List</button></div>
<c:if test="${active_case_objection > 0 && business_process_sub_name != 'APPLICATION FOR OBJECTION' && job_purpose != 'Update Objection Status'}"><div class="objected-application-alert p-3 mb-4"><div class="d-flex justify-content-between align-items-center flex-wrap gap-3"><div class="d-flex align-items-center gap-3"><span class="objected-icon rounded-circle d-inline-flex align-items-center justify-content-center"><i class="bi bi-exclamation-octagon fs-4"></i></span><div><span class="objected-status-pill">Application Objected</span><div class="text-danger fw-semibold mt-1">${active_case_objection} objection${active_case_objection > 1 ? 's' : ''} recorded against this application.</div></div></div><button class="btn btn-danger btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseObjections"><i class="bi bi-eye me-1"></i>View Objections</button></div></div></c:if>
<input type="hidden" id="cs_main_case_number" name="cs_main_case_number" value="${case_number}">
<input type="hidden" id="cs_main_job_number" name="cs_main_job_number" value="${job_number}">
<input type="hidden" id="cs_main_business_process_id" value="${business_process_id}">
<input type="hidden" id="cs_main_business_process_name" value="${business_process_name}">
<input type="hidden" id="cs_main_business_process_sub_id" value="${business_process_sub_id}">
<input type="hidden" id="cs_main_business_process_sub_name" value="${business_process_sub_name}">
<input type="hidden" id="cs_main_client_number" value="${phone_number}">
<input type="hidden" id="cs_main_transaction_number" name="cs_main_transaction_number" value="${transaction_number}">
<input type="hidden" id="txt_new_lc_registration_district_number" name="txt_new_lc_registration_district_number" value="${registration_district_number}">
<input type="hidden" id="txt_new_lc_registration_section_number" name="txt_new_lc_registration_section_number" value="${registration_section_number}">
<input type="hidden" id="txt_new_lc_registration_block_number" name="txt_new_lc_registration_block_number" value="${registration_block_number}">

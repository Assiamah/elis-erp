<input type="hidden" id="request_id" name="request_id" value="${rq_id}">
<input type="hidden" id="cs_main_ar_name" name="cs_main_ar_name" value="${ar_name}">
<input type="hidden" id="lc_fr_bl_wkt_polygon" name="lc_fr_bl_wkt_polygon" value="${fn:escapeXml(parcel_wkt)}">
<c:forEach items="${mother_to_child_link_list}" var="mother_to_child_link_row"><input type="hidden" name="es_case_number" id="m_es_case_number" value="${mother_to_child_link_row.mc_case_number}"><input type="hidden" name="es_job_number" id="m_es_job_number" value="${mother_to_child_link_row.mc_job_number}"></c:forEach>
<div class="row g-4" style="min-height:100vh"><div class="col-lg-8 scrollable-col">
<div class="card mb-4"><div class="card-header section-header d-flex justify-content-between align-items-center"><div class="d-flex align-items-center gap-3"><span class="avatar avatar-md rounded-circle"><i class="bi bi-file-text fs-5"></i></span><h6 class="mb-0 fw-bold">Case Summary</h6></div><button class="btn btn-sm btn-outline-dark" type="button" data-bs-toggle="collapse" data-bs-target="#caseSummaryCollapse"><i class="bi bi-chevron-down me-1"></i>Click to Expand</button></div><div class="collapse" id="caseSummaryCollapse"><div class="card-body">
<div class="card mb-3"><div class="card-header section-header"><h6 class="mb-0"><i class="bi bi-geo-alt me-2"></i>Parcel Attributes</h6></div><div class="card-body"><div class="row g-3">
<div class="col-md-4"><div class="data-label">Date Created</div><div class="data-value">${empty created_date ? "--" : created_date}</div></div>
<div class="col-md-4"><div class="data-label">Last Modified</div><div class="data-value">${empty modified_date ? "--" : modified_date}</div></div>
<div class="col-md-4"><div class="data-label">Case Number</div><div class="data-value">${empty case_number ? "--" : case_number}</div></div>

<div class="accordion-item"><h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseLettersOnCase" aria-expanded="false"><i class="bi bi-envelope me-2"></i>Letters on Case</button></h2><div id="collapseLettersOnCase" class="accordion-collapse collapse " data-bs-parent="#sidebarAccordion"><div class="accordion-body"><div class="d-flex gap-2 mb-3"><select id="type_of_letter_new" name="type_of_letter_new" class="form-select form-select-sm"><option value="Select_Letter_Template">Select Letter Template</option><option value="Inspection_Letter">Inspection Letter</option><option value="Physical_Planning_Letter">Physical Planning Letter</option><option value="Query_Letter">Query Letter</option><option value="Objection_Letter">Objection Letter</option></select><button class="btn btn-primary btn-sm" id="lc_btn_add_update_letters">Add</button><button class="btn btn-outline-primary btn-sm" id="btnloadlettersoncase">Load</button></div><div class="table-responsive"><table class="table table-sm table-hover"><thead><tr><th>Date</th><th>Letter Type</th><th>Created By</th><th>Action</th></tr></thead><tbody><c:forEach items="${case_letters}" var="letter"><tr><td>${letter.created_date}</td><td>${letter.letter_type}</td><td>${letter.created_by}</td><td><button type="button" id="btn-view-letters" data-id="${letter.id}" data-letter_type="${letter.letter_type}" data-letter_template="${fn:escapeXml(letter.letter_template)}" data-carbon_copy="${letter.carbon_copy}" class="btn btn-primary btn-sm edit_letter_modal_open"><i class="fas fa-eye"></i> View</button></td></tr></c:forEach></tbody></table></div></div></div></div>
<div class="accordion-item"><h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseCaseSteps" aria-expanded="false"><i class="bi bi-list me-2"></i>Case Steps</button></h2><div id="collapseCaseSteps" class="accordion-collapse collapse " data-bs-parent="#sidebarAccordion"><div class="accordion-body"><c:forEach items="${baby_step_milestone_list}" var="milestone"><div class="card mb-3"><div class="card-body"><h6 class="fw-bold">${milestone.milestone_description}</h6><ul class="list-unstyled mb-0"><c:forEach items="${milestone.baby_steps}" var="process"><li class="border-bottom py-2"><div class="d-flex justify-content-between gap-2"><span><i class="fas ${process.bse_status == 'Completed' ? 'fa-check-circle text-success' : process.bse_status == 'Ongoing' ? 'fa-spinner text-warning' : 'fa-times-circle text-danger'} me-2"></i>${process.bse_description}</span><span class="badge ${process.bse_status == 'Completed' ? 'bg-success' : process.bse_status == 'Ongoing' ? 'bg-warning text-dark' : 'bg-danger'}">${process.bse_status}</span></div><small class="text-muted">Performed by: ${empty process.completed_by ? 'Pending' : process.completed_by} | ${empty process.complete_by_date ? 'N/A' : process.complete_by_date}</small></li></c:forEach></ul></div></div></c:forEach></div></div></div>

<div class="col-md-4"><div class="data-label">WKT Polygon</div><div class="data-value">${empty parcel_wkt ? "--" : parcel_wkt}</div></div>
</div></div></div><div class="card"><div class="card-header section-header"><h6 class="mb-0"><i class="bi bi-receipt me-2"></i>Transaction Details</h6></div><div class="card-body"><div class="row g-3">
<div class="col-md-4"><div class="data-label">Transaction Number</div><div class="data-value">${empty transaction_number ? "--" : transaction_number}</div></div>
<div class="col-md-4"><div class="data-label">Applicant Name</div><div class="data-value">${empty ar_name ? "--" : ar_name}</div></div>
<div class="col-md-4"><div class="data-label">Application Type</div><div class="data-value">${empty business_process_sub_name ? "--" : business_process_sub_name}</div></div>

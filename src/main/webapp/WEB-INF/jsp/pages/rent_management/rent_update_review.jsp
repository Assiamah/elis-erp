<style>
.rent-review{--rr-deep:#064b39;--rr-green:#087f5b;--rr-mint:#e8f7ee;--rr-border:#d8e9df;--rr-text:#173b2e;color:var(--rr-text)}
.rent-review .rr-hero{background:linear-gradient(115deg,#064b39,#0a8b61 72%,#31a477);color:#fff;border-radius:17px;padding:24px 28px;box-shadow:0 10px 30px #064b3926}
.rent-review .rr-hero h1{color:#fff;font-size:24px;font-weight:800;margin:5px 0}.rent-review .rr-hero p{color:#d8f8e7;margin:0;font-size:13px}.rent-review .rr-eyebrow{font-size:11px;font-weight:800;letter-spacing:1.3px;color:#bdf2d4}.rent-review .breadcrumb-item,.rent-review .breadcrumb-item a{color:#e6fff0!important}.rent-review .breadcrumb-item+.breadcrumb-item::before{color:#bdf2d4}
.rent-review .rr-card{background:#fff;border:1px solid var(--rr-border);border-radius:15px;box-shadow:0 5px 20px #064b3910;overflow:hidden}.rent-review .rr-card-head{padding:17px 20px;border-bottom:1px solid var(--rr-border);display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap}.rent-review .rr-card-title{font-size:15px;font-weight:800;color:var(--rr-deep);margin:0}.rent-review .rr-desc{font-size:12px;color:#71877a;margin:4px 0 0}.rent-review .rr-card-body{padding:20px}
.rent-review .rr-metric{display:flex;align-items:center;gap:13px;padding:18px;border-left:4px solid var(--rr-green)}.rent-review .rr-metric.amber{border-left-color:#d7a03d}.rent-review .rr-metric.red{border-left-color:#c94c4c}.rent-review .rr-icon{width:44px;height:44px;display:grid;place-items:center;background:var(--rr-mint);border-radius:12px;color:var(--rr-green);font-size:22px;flex:none}.rent-review .rr-metric.amber .rr-icon{background:#fff5e0;color:#b77d16}.rent-review .rr-metric.red .rr-icon{background:#fff0f0;color:#b53d3d}.rent-review .rr-metric label{display:block;font-size:12px;color:#6b8475;font-weight:700}.rent-review .rr-metric strong{display:block;color:var(--rr-deep);font-size:23px;font-weight:800;line-height:1.3;margin-top:3px}
.rent-review .form-label{font-size:12px;font-weight:750;color:#365d49}.rent-review .form-control,.rent-review .form-select{min-height:42px;border:1px solid #cfe4d7;border-radius:9px;font-size:13px}.rent-review .form-control:focus,.rent-review .form-select:focus{border-color:#0b9469;box-shadow:0 0 0 .2rem #0b94691c}.rent-review .rr-filter{background:#f3fbf6;border:1px solid #d8ebde;border-radius:12px;padding:17px}
.rent-review .rr-btn{border-radius:9px;padding:10px 14px;font-size:12px;font-weight:750;border:1px solid transparent;display:inline-flex;gap:7px;align-items:center;justify-content:center;white-space:nowrap}.rent-review .rr-btn-primary{background:linear-gradient(110deg,#087f5b,#0ba26f);color:#fff}.rent-review .rr-btn-primary:hover{background:#065c44;color:#fff}.rent-review .rr-btn-soft{background:#e5f7ed;color:#07543f;border-color:#bce2ca}.rent-review .rr-btn-outline{background:#fff;border-color:#bcd9c8;color:#07543f}.rent-review .rr-btn-outline:hover{background:#f2faf5}.rent-review .rr-btn-danger{background:#fff1f1;color:#b42318;border-color:#f3c5c5}.rent-review .rr-btn:disabled{opacity:.5;cursor:not-allowed}
.rent-review .rr-table-wrap{overflow:auto;max-height:510px}.rent-review #rrRequestsTable{width:100%;font-size:12px;white-space:nowrap}.rent-review #rrRequestsTable thead th{position:sticky;top:0;z-index:1;background:linear-gradient(110deg,#07543f,#0b9064);color:#fff;border:0;padding:13px 11px;font-weight:750}.rent-review #rrRequestsTable tbody td{padding:12px 11px;border-bottom:1px solid #e5efe8;vertical-align:middle}.rent-review #rrRequestsTable tbody tr:nth-child(even){background:#f7fcf9}.rent-review #rrRequestsTable tbody tr:hover{background:#eaf7ef}
.rent-review .rr-tag{display:inline-flex;align-items:center;gap:5px;padding:5px 9px;background:#e8f7ed;color:#087f5b;border-radius:50px;font-size:11px;font-weight:750}.rent-review .rr-tag.pending{background:#fff3d9;color:#9b690b}.rent-review .rr-tag.rejected{background:#ffeded;color:#a83232}.rent-review .rr-tag.approved{background:#e8f7ed;color:#087f5b}.rent-review .rr-empty{padding:45px 15px;text-align:center;color:#779083}.rent-review .rr-empty i{font-size:38px;display:block;margin-bottom:8px;color:#91b9a2}.rent-review .rr-message{font-size:12px;min-height:20px}.rent-review .rr-diff{width:100%;border-collapse:collapse;font-size:12px}.rent-review .rr-diff th{background:#edf7f0;color:#07543f;text-align:left;padding:11px}.rent-review .rr-diff td{border-bottom:1px solid #e4efe8;padding:11px;vertical-align:top;overflow-wrap:anywhere}.rent-review .rr-diff tr.changed{background:#fff9e9}.rent-review .rr-diff tr.changed td:last-child{color:#07543f;font-weight:750}.rent-review .rr-detail-label{font-size:11px;text-transform:uppercase;letter-spacing:.5px;color:#758b7d}.rent-review .rr-detail-value{font-weight:750;color:#153e2c}.rent-review .rr-check{accent-color:#087f5b}.rent-review .rr-note{background:#f4fbf6;border:1px solid #d8ebde;border-radius:10px;padding:12px;font-size:12px;color:#587362}
#rentChangeReviewModal .modal-content{border:0;border-radius:16px;overflow:hidden}#rentChangeReviewModal .modal-header{background:linear-gradient(110deg,#064b39,#0b9469);color:#fff}#rentChangeReviewModal .modal-title{color:#fff;font-weight:800}#rentChangeReviewModal .btn-close{filter:invert(1) grayscale(1)}
@media(max-width:767px){.rent-review .rr-hero{padding:18px}.rent-review .rr-hero h1{font-size:20px}.rent-review .rr-card-body{padding:13px}.rent-review .rr-metric{padding:13px}}
</style>

<div class="main-content app-content rent-review" id="rentReviewRoot">
 <div class="container-fluid page-container">
  <div class="rr-hero mb-4"><div class="d-flex align-items-center justify-content-between gap-3 flex-wrap"><div><div class="rr-eyebrow"><i class="ri-government-line me-1"></i> ELIS / GROUND RENT / DATA CONTROL</div><h1><i class="ri-shield-check-line me-2"></i>Rent Data Change Review &amp; Approval</h1><p>Review proposed changes to rent records, compare existing and requested values, and approve or reject updates with an audit trail.</p></div><ol class="breadcrumb mb-0"><li class="breadcrumb-item"><a href="javascript:void(0)">ELIS</a></li><li class="breadcrumb-item active">Rent Change Approvals</li></ol></div></div>

  <div class="row g-3 mb-4">
   <div class="col-xl-3 col-sm-6"><div class="rr-card h-100"><div class="rr-metric amber"><div class="rr-icon"><i class="ri-time-line"></i></div><div><label>Pending Review</label><strong id="rrPendingCount">0</strong></div></div></div></div>
   <div class="col-xl-3 col-sm-6"><div class="rr-card h-100"><div class="rr-metric"><div class="rr-icon"><i class="ri-checkbox-circle-line"></i></div><div><label>Approved</label><strong id="rrApprovedCount">0</strong></div></div></div></div>
   <div class="col-xl-3 col-sm-6"><div class="rr-card h-100"><div class="rr-metric red"><div class="rr-icon"><i class="ri-close-circle-line"></i></div><div><label>Rejected</label><strong id="rrRejectedCount">0</strong></div></div></div></div>
   <div class="col-xl-3 col-sm-6"><div class="rr-card h-100"><div class="rr-metric"><div class="rr-icon"><i class="ri-file-list-3-line"></i></div><div><label>Requests Loaded</label><strong id="rrTotalCount">0</strong></div></div></div></div>
  </div>

  <div class="rr-card mb-3"><div class="rr-card-head"><div><h2 class="rr-card-title"><i class="ri-filter-3-line me-2"></i>Step 1 — Find Rent Data Change Requests</h2><p class="rr-desc">Filter by estate, account, change type, officer, date and review status.</p></div><span class="rr-tag"><i class="ri-search-line"></i> Approval queue</span></div><div class="rr-card-body"><div class="rr-filter"><div class="row g-3 align-items-end">
   <div class="col-xl-3 col-md-6"><label class="form-label" for="rrEstate">Estate</label><select class="form-select" id="rrEstate"><option value="">All Estates</option><c:forEach items="${estate_list}" var="estate"><option value="<c:out value='${estate.ge_id}'/>"><c:out value="${estate.ge_location_name}"/></option></c:forEach></select></div>
   <div class="col-xl-3 col-md-6"><label class="form-label" for="rrSearch">Account / Lessee / File / Plot</label><input class="form-control" id="rrSearch" type="search" placeholder="Search rent records..."></div>
   <div class="col-xl-2 col-md-6"><label class="form-label" for="rrStatus">Review Status</label><select class="form-select" id="rrStatus"><option value="PENDING" selected>Pending Review</option><option value="">All Statuses</option><option value="APPROVED">Approved</option><option value="REJECTED">Rejected</option></select></div>
   <div class="col-xl-2 col-md-6"><label class="form-label" for="rrChangeType">Change Type</label><select class="form-select" id="rrChangeType"><option value="">All Changes</option><option value="LESSEE">Lessee Details</option><option value="PROPERTY">Property Details</option><option value="TENURE">Tenure</option><option value="RENT_TERMS">Rent Terms</option><option value="PAYMENT">Payment History</option><option value="OTHER">Other</option></select></div>
   <div class="col-xl-2 col-md-6"><label class="form-label" for="rrOfficer">Submitted By</label><input class="form-control" id="rrOfficer" placeholder="Officer name / ID"></div>
   <div class="col-xl-3 col-md-6"><label class="form-label" for="rrDateFrom">Submitted From</label><input type="date" class="form-control" id="rrDateFrom"></div>
   <div class="col-xl-3 col-md-6"><label class="form-label" for="rrDateTo">Submitted To</label><input type="date" class="form-control" id="rrDateTo"></div>
   <div class="col-xl-6 col-md-12 d-flex gap-2"><button class="rr-btn rr-btn-primary flex-fill" id="rrLoadButton" type="button"><i class="ri-search-line"></i> Load Change Requests</button><button class="rr-btn rr-btn-outline" id="rrResetButton" type="button"><i class="ri-refresh-line"></i> Reset</button></div>
  </div></div></div></div>

  <div class="rr-card mb-3"><div class="rr-card-head"><div><h2 class="rr-card-title"><i class="ri-list-check-2 me-2"></i>Step 2 — Review Submitted Changes</h2><p class="rr-desc">Open a request to inspect every proposed field change before making a decision.</p></div><button class="rr-btn rr-btn-soft" id="rrRefreshButton" type="button"><i class="ri-refresh-line"></i> Refresh Queue</button></div><div class="rr-table-wrap"><table class="table table-hover mb-0" id="rrRequestsTable"><thead><tr><th>Request ID</th><th>Account Number</th><th>Lessee / Assignee</th><th>Estate</th><th>Change Type</th><th>Submitted By</th><th>Submitted At</th><th>Fields Changed</th><th>Status</th><th>Action</th></tr></thead><tbody id="rrTableBody"><tr><td colspan="10"><div class="rr-empty"><i class="ri-file-search-line"></i>Click <strong>Load Change Requests</strong> to retrieve the approval queue.</div></td></tr></tbody></table></div><div class="rr-card-body border-top"><div class="d-flex justify-content-between flex-wrap gap-2 align-items-center"><span class="small text-muted" id="rrResultsSummary">No requests loaded</span><div class="d-flex align-items-center gap-2"><button type="button" class="rr-btn rr-btn-outline" id="rrPrevPage" disabled><i class="ri-arrow-left-s-line"></i> Previous</button><span class="small" id="rrPageLabel">Page 1</span><button type="button" class="rr-btn rr-btn-outline" id="rrNextPage" disabled>Next <i class="ri-arrow-right-s-line"></i></button></div></div></div></div>

  <div class="rr-card mb-4"><div class="rr-card-head"><h2 class="rr-card-title"><i class="ri-shield-keyhole-line me-2"></i>Approval Controls</h2></div><div class="rr-card-body"><div class="row g-3"><div class="col-md-4"><span class="rr-tag">01 · Verify</span><p class="rr-desc mt-2">Compare original and proposed data against supporting records and documents.</p></div><div class="col-md-4"><span class="rr-tag">02 · Decide</span><p class="rr-desc mt-2">Approve valid changes or reject with a mandatory reason. Reviewers must not approve their own submissions.</p></div><div class="col-md-4"><span class="rr-tag">03 · Audit</span><p class="rr-desc mt-2">The server must log reviewer, timestamp, reason, record version and final outcome for every decision.</p></div></div><div id="rrMessage" class="rr-message mt-3" role="status" aria-live="polite"></div></div></div>
 </div>
</div>

<div class="modal fade" id="rentChangeReviewModal" tabindex="-1" aria-labelledby="rrReviewModalTitle" aria-hidden="true" data-bs-backdrop="static"><div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable"><div class="modal-content"><div class="modal-header"><div><h5 class="modal-title" id="rrReviewModalTitle"><i class="ri-file-search-line me-2"></i>Review Rent Data Change</h5><small class="text-white-50">Verify the submitted changes before approving or rejecting.</small></div><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body p-4">
 <div class="row g-3 mb-3" id="rrRequestMeta"></div>
 <div class="rr-note mb-3"><i class="ri-information-line me-1"></i> Highlighted rows contain proposed changes. Original values are read-only; approval must be applied transactionally by the server.</div>
 <div class="table-responsive mb-4"><table class="rr-diff"><thead><tr><th style="width:27%">Field</th><th style="width:36%">Existing Value</th><th style="width:37%">Proposed Value</th></tr></thead><tbody id="rrDiffBody"></tbody></table></div>
 <div class="mb-3"><h6 class="fw-bold" style="color:#064b39">Reason for Change</h6><div class="rr-note" id="rrChangeReason">Not supplied.</div></div>
 <div class="mb-3"><h6 class="fw-bold" style="color:#064b39">Supporting Documents</h6><div id="rrAttachments" class="small text-muted">No supporting documents supplied.</div></div>
 <div class="mb-3"><h6 class="fw-bold" style="color:#064b39">Decision History</h6><div id="rrHistory" class="small text-muted">No previous decisions.</div></div>
 <div class="mb-2"><label class="form-label" for="rrDecisionComment">Reviewer Comments / Reason <span class="text-danger" id="rrCommentRequired">(required for rejection)</span></label><textarea class="form-control" id="rrDecisionComment" rows="3" maxlength="2000" placeholder="Enter your review notes or reason for rejection..."></textarea></div>
 <div class="form-check mt-3"><input type="checkbox" class="form-check-input rr-check" id="rrConfirmReview"><label class="form-check-label small" for="rrConfirmReview">I have checked the original and proposed values against the supporting evidence.</label></div>
 <div class="rr-message mt-2" id="rrModalMessage" role="status" aria-live="polite"></div>
 </div><div class="modal-footer d-flex justify-content-between gap-2 flex-wrap"><button type="button" class="rr-btn rr-btn-outline" data-bs-dismiss="modal"><i class="ri-close-line"></i> Close</button><div class="d-flex gap-2"><button type="button" class="rr-btn rr-btn-danger" id="rrRejectButton"><i class="ri-close-circle-line"></i> Reject Changes</button><button type="button" class="rr-btn rr-btn-primary" id="rrApproveButton"><i class="ri-checkbox-circle-line"></i> Approve &amp; Apply Changes</button></div></div></div></div></div>

<script>
(function(){
 'use strict';
 /* BACKEND CONTRACT (implement in ELIS before production use):
  GET  /rent/change-approval/requests?estate_id=&keyword=&status=&change_type=&submitted_by=&date_from=&date_to=&page=&page_size=
       returns {success:true,data:[{request_id,account_number,lessee_name,estate_name,change_type,submitted_by,submitted_at,changed_fields,status,version}],total:integer}
  GET  /rent/change-approval/requests/{request_id}
       returns {success:true,data:{request_id,account_number,lessee_name,estate_name,change_type,submitted_by,submitted_at,status,version,reason,
          changes:[{field,label,old_value,new_value}],attachments:[{name,url}],history:[{action,actor,date,comment}]}}
  POST /rent/change-approval/decision
       JSON {request_id,version,decision:'APPROVE'|'REJECT',comment}; returns {success:true,message:'...'}.
  Server MUST authenticate/authorize reviewer, enforce maker-checker separation, validate current row/version and supporting evidence,
  atomically apply approved changes to rent ledger, reject stale requests, and persist immutable audit events. */
 const ROOT='${pageContext.request.contextPath}/rent/change-approval';
 const $id=id=>document.getElementById(id);
 const esc=v=>String(v==null?'':v).replace(/[&<>"']/g,ch=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch]));
 const val=(obj,keys,def='')=>{for(const key of keys){if(obj&&obj[key]!==undefined&&obj[key]!==null)return obj[key];}return def;};
 const txt=(id,v)=>{$id(id).textContent=String(v);};
 let rows=[],total=0,page=1,pageSize=20,loading=false,decisionBusy=false,current=null;
 function msg(message,error,modal){const el=$id(modal?'rrModalMessage':'rrMessage');el.textContent=message;el.style.color=error?'#b42318':'#087f5b';}
 function badge(status){const s=String(status||'PENDING').toUpperCase();const cls=s==='APPROVED'?'approved':s==='REJECTED'?'rejected':'pending';return '<span class="rr-tag '+cls+'">'+esc(s.replace(/_/g,' '))+'</span>';}
 function render(){const body=$id('rrTableBody');body.innerHTML='';if(!rows.length){body.innerHTML='<tr><td colspan="10"><div class="rr-empty"><i class="ri-inbox-line"></i>No change requests match the selected filters.</div></td></tr>';}
  rows.forEach(r=>{const tr=document.createElement('tr');const id=String(val(r,['request_id','id']));const columns=[id,val(r,['account_number','account_no']),val(r,['lessee_name','owners_name','name']),val(r,['estate_name','estate']),val(r,['change_type']),val(r,['submitted_by','requested_by']),val(r,['submitted_at','created_at']),val(r,['changed_fields','field_count'],0)];columns.forEach(v=>{const td=document.createElement('td');td.textContent=String(v);tr.appendChild(td);});const status=document.createElement('td');status.innerHTML=badge(r.status);tr.appendChild(status);const action=document.createElement('td');const btn=document.createElement('button');btn.type='button';btn.className='rr-btn rr-btn-soft';btn.innerHTML='<i class="ri-eye-line"></i> Review';btn.addEventListener('click',()=>openReview(id));action.appendChild(btn);tr.appendChild(action);body.appendChild(tr);});
  txt('rrTotalCount',total.toLocaleString());txt('rrPendingCount',rows.filter(r=>String(r.status||'').toUpperCase()==='PENDING').length);txt('rrApprovedCount',rows.filter(r=>String(r.status||'').toUpperCase()==='APPROVED').length);txt('rrRejectedCount',rows.filter(r=>String(r.status||'').toUpperCase()==='REJECTED').length);
  const start=total?((page-1)*pageSize+1):0;txt('rrResultsSummary','Showing '+start+'–'+(start+rows.length)+' of '+total+' requests');txt('rrPageLabel','Page '+page+' of '+Math.max(1,Math.ceil(total/pageSize)));$id('rrPrevPage').disabled=page<=1;$id('rrNextPage').disabled=page*pageSize>=total;
 }
 function csrfHeaders(){const headers={'Accept':'application/json'};const token=document.querySelector('meta[name="_csrf"]');const name=document.querySelector('meta[name="_csrf_header"]');if(token&&name)headers[name.content]=token.content;return headers;}
 async function getJSON(url,options){const response=await fetch(url,Object.assign({credentials:'same-origin',headers:csrfHeaders()},options||{}));if(!response.ok)throw new Error('Request failed (HTTP '+response.status+').');const data=await response.json();if(data&&data.success===false)throw new Error(data.message||'Server rejected the request.');return data;}
 async function load(){if(loading)return;loading=true;$id('rrLoadButton').disabled=true;msg('Loading change requests...');const q=new URLSearchParams({estate_id:$id('rrEstate').value,keyword:$id('rrSearch').value.trim(),status:$id('rrStatus').value,change_type:$id('rrChangeType').value,submitted_by:$id('rrOfficer').value.trim(),date_from:$id('rrDateFrom').value,date_to:$id('rrDateTo').value,page:String(page),page_size:String(pageSize)});
  try{const result=await getJSON(ROOT+'/requests?'+q);const data=Array.isArray(result)?result:val(result,['data','records'],[]);if(!Array.isArray(data))throw new Error('The service did not return an array of requests.');rows=data;total=Number(val(result,['total','total_count','count'],rows.length))||0;render();msg('Change requests loaded. Open a record to review its proposed changes.');}catch(err){rows=[];total=0;render();msg(err.message,true);}finally{loading=false;$id('rrLoadButton').disabled=false;}}
 function safeDocumentUrl(url){try{const u=new URL(url,window.location.href);return u.origin===window.location.origin&&['http:','https:'].includes(u.protocol)?u.href:null;}catch(e){return null;}}
 function detail(label,value){return '<div class="col-sm-6 col-lg-3"><div class="rr-detail-label">'+esc(label)+'</div><div class="rr-detail-value">'+esc(value||'—')+'</div></div>';}
 async function openReview(id){current=null;msg('Loading request details...',false,true);$id('rrApproveButton').disabled=true;$id('rrRejectButton').disabled=true;
  try{const result=await getJSON(ROOT+'/requests/'+encodeURIComponent(id));const r=result.data||result.request||result;if(!r||!val(r,['request_id','id']))throw new Error('Invalid request detail response.');current=r;txt('rrReviewModalTitle','Review Rent Change — '+val(r,['request_id','id']));
   $id('rrRequestMeta').innerHTML=detail('Account Number',r.account_number)+detail('Lessee / Assignee',r.lessee_name||r.owners_name)+detail('Estate',r.estate_name||r.estate)+detail('Change Type',r.change_type)+detail('Submitted By',r.submitted_by||r.requested_by)+detail('Submitted At',r.submitted_at||r.created_at)+detail('Status',r.status)+detail('Record Version',r.version);
   const changes=Array.isArray(r.changes)?r.changes:[];$id('rrDiffBody').innerHTML=changes.length?changes.map(c=>{const oldValue=val(c,['old_value','before']),newValue=val(c,['new_value','after']);const changed=JSON.stringify(oldValue)!==JSON.stringify(newValue);const display=v=>typeof v==='object'&&v!==null?JSON.stringify(v):String(v==null?'—':v);return '<tr class="'+(changed?'changed':'')+'"><td><strong>'+esc(c.label||c.field||'Field')+'</strong></td><td>'+esc(display(oldValue))+'</td><td>'+esc(display(newValue))+'</td></tr>';}).join(''):'<tr><td colspan="3" class="text-muted text-center py-3">No field comparison returned by the service.</td></tr>';
   txt('rrChangeReason',r.reason||r.change_reason||'No reason provided.');const attachments=Array.isArray(r.attachments)?r.attachments:[];$id('rrAttachments').innerHTML=attachments.length?attachments.map(a=>{const link=safeDocumentUrl(a.url);return link?'<div class="mb-2"><a href="'+esc(link)+'" target="_blank" rel="noopener noreferrer"><i class="ri-attachment-line me-1"></i>'+esc(a.name||'Supporting document')+'</a></div>':'<div class="mb-2">'+esc(a.name||'Supporting document')+' (link unavailable)</div>';}).join(''):'No supporting documents supplied.';
   const history=Array.isArray(r.history)?r.history:[];$id('rrHistory').innerHTML=history.length?history.map(h=>'<div class="border-bottom py-2"><strong>'+esc(h.action||'Action')+'</strong> · '+esc(h.actor||'Unknown')+' · '+esc(h.date||'')+'<div>'+esc(h.comment||'')+'</div></div>').join(''):'No previous decisions.';
   $id('rrDecisionComment').value='';$id('rrConfirmReview').checked=false;const pending=String(r.status||'').toUpperCase()==='PENDING';$id('rrApproveButton').disabled=!pending||!changes.length;$id('rrRejectButton').disabled=!pending;msg(pending?'Review the changes and confirm your checks.':'This request has already been decided and is read-only.',false,true);
   if(window.bootstrap&&bootstrap.Modal)bootstrap.Modal.getOrCreateInstance($id('rentChangeReviewModal')).show();else msg('Bootstrap modal support is unavailable.',true);
  }catch(err){msg(err.message,true,true);msg(err.message,true);}}
 async function decide(decision){if(decisionBusy||!current)return;const requestId=val(current,['request_id','id']);const comment=$id('rrDecisionComment').value.trim();if(!$id('rrConfirmReview').checked){msg('Confirm that you have verified the change against the supporting evidence.',true,true);return;}if(decision==='REJECT'&&!comment){msg('A rejection reason is required.',true,true);$id('rrDecisionComment').focus();return;}if(decision==='APPROVE'&&!(Array.isArray(current.changes)&&current.changes.length)){msg('Cannot approve a request without a field comparison.',true,true);return;}if(!window.confirm((decision==='APPROVE'?'Approve and apply':'Reject')+' change request '+requestId+'?'))return;
  decisionBusy=true;$id('rrApproveButton').disabled=true;$id('rrRejectButton').disabled=true;msg('Submitting review decision...',false,true);
  try{const headers=csrfHeaders();headers['Content-Type']='application/json';const result=await getJSON(ROOT+'/decision',{method:'POST',headers,body:JSON.stringify({request_id:requestId,version:current.version,decision:decision,comment:comment})});msg(result.message||'Decision saved successfully.',false);if(window.bootstrap&&bootstrap.Modal){const modal=bootstrap.Modal.getInstance($id('rentChangeReviewModal'));if(modal)modal.hide();}current=null;await load();}catch(err){msg(err.message,true,true);$id('rrApproveButton').disabled=false;$id('rrRejectButton').disabled=false;}finally{decisionBusy=false;}}
 $id('rrLoadButton').addEventListener('click',()=>{page=1;load();});$id('rrRefreshButton').addEventListener('click',load);$id('rrPrevPage').addEventListener('click',()=>{if(page>1){page--;load();}});$id('rrNextPage').addEventListener('click',()=>{if(page*pageSize<total){page++;load();}});
 $id('rrResetButton').addEventListener('click',()=>{$id('rrEstate').value='';$id('rrSearch').value='';$id('rrStatus').value='PENDING';$id('rrChangeType').value='';$id('rrOfficer').value='';$id('rrDateFrom').value='';$id('rrDateTo').value='';page=1;load();});$id('rrApproveButton').addEventListener('click',()=>decide('APPROVE'));$id('rrRejectButton').addEventListener('click',()=>decide('REJECT'));
 render();
})();
</script>

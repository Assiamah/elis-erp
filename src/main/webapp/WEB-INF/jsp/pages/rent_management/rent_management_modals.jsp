<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c" %>
<%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>
<jsp:useBean id="now" class="java.util.Date" />
<style>
/* ELIS rent modals: shared emerald visual language; limited to modal elements below */
.rent-elis-modal{--re-green:#087f5b;--re-deep:#07543f;--re-border:#dcece2;--re-ink:#244c3b}
.rent-elis-modal .modal-dialog{max-width:960px}
.rent-elis-modal .modal-content{border:0;border-radius:17px;overflow:hidden;box-shadow:0 24px 65px rgba(5,61,42,.22)}
.rent-elis-modal .modal-header{background:linear-gradient(105deg,#07543f,#0b8a61 65%,#38a77d);padding:19px 24px;border:0;color:#fff}
.rent-elis-modal .modal-title{font-size:18px;font-weight:800;color:#fff;display:flex;align-items:center;gap:10px}
.rent-elis-modal .modal-header .btn-close{filter:brightness(0) invert(1);opacity:.9}
.rent-elis-modal .modal-body{background:#fbfdfb;padding:22px 24px;max-height:calc(100vh - 190px);overflow-y:auto}
.rent-elis-modal .modal-footer{background:#f0f9f3;border-top:1px solid var(--re-border);padding:15px 24px}
.rent-elis-modal .re-section{background:#fff;border:1px solid var(--re-border);border-radius:13px;overflow:hidden;margin-bottom:17px;box-shadow:0 3px 12px rgba(8,84,57,.04)}
.rent-elis-modal .re-section-heading{background:#e9f7ef;border-bottom:1px solid #cce7d8;color:#07543f;font-size:13px;font-weight:800;padding:12px 16px;display:flex;align-items:center;gap:9px}
.rent-elis-modal .re-section-body{padding:17px}
.rent-elis-modal .form-label{font-size:12px;font-weight:750;color:#315c49;margin-bottom:6px}
.rent-elis-modal .form-control,.rent-elis-modal .form-select{border:1px solid #d4e7dc;border-radius:9px;font-size:13px;min-height:40px}
.rent-elis-modal .form-control:focus,.rent-elis-modal .form-select:focus{border-color:#0d9669;box-shadow:0 0 0 .2rem rgba(13,150,105,.12)}
.rent-elis-modal .btn{border-radius:9px;font-weight:700}
.rent-elis-modal .btn-success,.rent-elis-modal .btn-primary{background:#087f5b;border-color:#087f5b;color:#fff}
.rent-elis-modal .btn-success:hover,.rent-elis-modal .btn-primary:hover{background:#07543f;border-color:#07543f;color:#fff}
.rent-elis-modal .btn-light{background:#edf6ef;border:1px solid #d4e7dc;color:#255543}
.rent-elis-modal .re-table-wrap{border:1px solid var(--re-border);border-radius:11px;overflow:auto;background:white}
.rent-elis-modal table{width:100%!important;margin:0;font-size:12px}
.rent-elis-modal table thead th{background:linear-gradient(105deg,#07543f,#0b8a61)!important;color:#fff!important;font-size:11px;font-weight:800;letter-spacing:.2px;padding:12px 11px!important;white-space:nowrap;border-color:#197f5d!important}
.rent-elis-modal table tbody td{padding:10px!important;vertical-align:middle;border-color:#e5f0e8}
.rent-elis-modal table tbody tr:nth-child(even){background:#f6fbf7}
.rent-elis-modal .re-info{padding:11px 14px;background:#eaf7ee;border:1px solid #cfe9d7;border-radius:9px;color:#456c57;font-size:12px;margin-bottom:16px}
.rent-elis-modal .re-value{display:block;min-height:26px;color:#194a36;font-weight:650;overflow-wrap:anywhere}
.rent-elis-modal .re-field{padding:10px 12px;background:#f7fbf8;border:1px solid #e4f0e8;border-radius:9px;height:100%}
.rent-elis-modal .re-field strong{display:block;font-size:11px;color:#6a8977;margin-bottom:4px}
@media(max-width:767px){.rent-elis-modal .modal-body{padding:15px}.rent-elis-modal .modal-header{padding:16px}.rent-elis-modal .re-section-body{padding:12px}}
</style>

<div class="modal fade rent-elis-modal" id="transactionhistory" tabindex="-1" aria-labelledby="transactionhistoryTitle" aria-hidden="true">

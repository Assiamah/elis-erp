</form>
  </div><div class="modal-footer"><button type="button" class="btn btn-success" id="btn_save_rent_client_details"><i class="ri-save-line me-1"></i>Save Changes</button><button type="button" class="btn btn-light" data-bs-dismiss="modal">Close</button></div></div></div></div>


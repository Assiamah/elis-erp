<div class="re-section"><div class="re-section-heading"><i class="ri-map-pin-line"></i>Parcel's Details</div><div class="re-section-body"><div class="row"><div class="col-md-6 mb-3"><label class="form-label" for="rt_convenant_user">Covenanted User</label><select id="rt_convenant_user" class="form-select"><option value="" selected disabled>-- Select --</option><c:forEach items="${user_category_list}" var="u"><option value="<c:out value="${u.us_name}"/>"><c:out value="${u.us_name}"/></option></c:forEach></select></div><div class="col-md-6 mb-3"><label class="form-label" for="rt_current_use">Current User</label><select id="rt_current_use" class="form-select"><option value="" selected disabled>-- Select --</option><c:forEach items="${user_category_list}" var="u"><option value="<c:out value="${u.us_name}"/>"><c:out value="${u.us_name}"/></option></c:forEach></select></div><div class="col-md-6 mb-3"><label class="form-label" for="rt_nature_of_dev">Nature of Development</label><select id="rt_nature_of_dev" class="form-select"><option value="" selected disabled>-- Select --</option><c:forEach items="${nature_of_development_list}" var="n"><option value="<c:out value="${n.na_name}"/>"><c:out value="${n.na_name}"/></option></c:forEach></select></div><div class="col-md-6 mb-3"><label class="form-label" for="rt_plot_number">Plot Number <span class="text-danger">*</span></label><input type="text" id="rt_plot_number" class="form-control" required /></div><div class="col-md-6 mb-3"><label class="form-label" for="rt_plot_size">Plot Size (Acres) <span class="text-danger">*</span></label><input type="text" id="rt_plot_size" class="form-control" required /></div><div class="col-md-6 mb-3"><label class="form-label" for="rt_parcel_address">Parcel Address</label><input type="text" id="rt_parcel_address" class="form-control" /></div><div class="col-md-6 mb-3"><label class="form-label" for="rt_file_number">File Number <span class="text-danger">*</span></label><input type="text" id="rt_file_number" class="form-control" required /></div><div class="col-md-6 mb-3"><label class="form-label" for="rt_ledger">Ledger <span class="text-danger">*</span></label><input type="text" id="rt_ledger" class="form-control" required /></div><div class="col-md-6 mb-3"><label class="form-label" for="rt_folio">Folio</label><input type="text" id="rt_folio" class="form-control" /></div><div class="col-md-6 mb-3"><label class="form-label" for="rt_ls_number">LS Number</label><input type="text" id="rt_ls_number" class="form-control" /></div></div></div></div>

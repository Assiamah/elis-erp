<script>
document.addEventListener('DOMContentLoaded',function(){
 'use strict';
 const $id=id=>document.getElementById(id), form=$id('ai_chat_form'), input=$id('ai_user_input'), send=$id('ai_send_btn'), messages=$id('ai_chat_messages'), typing=$id('ai_typing_indicator');
 let map=null,vectorSource=null,vectorLayer=null;
 const esc=v=>String(v==null?'':v).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#039;');
 const fmt=v=>esc(v).replace(/\n/g,'<br>');
 function addMessage(role,value){const row=document.createElement('div');row.className='ea-message '+role;const avatar=document.createElement('div');avatar.className='ea-avatar';avatar.textContent=role==='user'?'YOU':'AI';const bubble=document.createElement('div');bubble.className='ea-bubble';bubble.innerHTML=fmt(value);const time=document.createElement('span');time.className='ea-time';time.textContent=new Date().toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'});bubble.appendChild(time);row.append(avatar,bubble);messages.insertBefore(row,typing);messages.scrollTop=messages.scrollHeight;}
 function loading(on){typing.classList.toggle('active',on);send.disabled=on;send.innerHTML=on?'<span class="spinner-border spinner-border-sm"></span> Sending...':'<i class="fas fa-paper-plane me-1"></i>Send';messages.scrollTop=messages.scrollHeight;}
 function normalize(r){if(r==null)return{success:false,message:'Empty response received.'};if(typeof r==='object')return r;try{return JSON.parse(r)}catch(e){return{success:true,message:String(r)}}}
 function payload(r){return r.data&&typeof r.data==='object'&&!Array.isArray(r.data)?Object.assign({},r,r.data):r}
 function answer(r){return r.answer||(typeof r.message==='string'?r.message:null)||(typeof r.data==='string'?r.data:null)||(r.data&&(r.data.answer||r.data.message))||'The AI query completed successfully.'}
 function renderRecords(rows){const empty=$id('ai_records_empty'),content=$id('ai_records_content'),head=$id('ai_result_table_header'),body=$id('ai_result_table_body');head.replaceChildren();body.replaceChildren();if(!Array.isArray(rows)||!rows.length){empty.classList.remove('d-none');content.classList.add('d-none');return;}empty.classList.add('d-none');content.classList.remove('d-none');const columns=[...new Set(rows.flatMap(r=>r&&typeof r==='object'?Object.keys(r).filter(k=>!['geometry','geojson'].includes(k.toLowerCase())):[]))];columns.forEach(k=>{const th=document.createElement('th');th.textContent=k;head.appendChild(th)});rows.forEach(r=>{const tr=document.createElement('tr');columns.forEach(k=>{const td=document.createElement('td');let v=r?.[k];td.textContent=v==null?'':typeof v==='object'?JSON.stringify(v):String(v);tr.appendChild(td)});body.appendChild(tr)});}
 function renderEvidence(items){const empty=$id('ai_evidence_empty'),list=$id('ai_evidence_list');list.replaceChildren();if(!Array.isArray(items)||!items.length){empty.classList.remove('d-none');list.classList.add('d-none');return;}empty.classList.add('d-none');list.classList.remove('d-none');items.forEach((v,i)=>{const x=typeof v==='string'?{text:v}:v||{},div=document.createElement('div');div.className='ea-evidence';let score='';if(x.score!=null){let s=Number(x.score);if(Number.isFinite(s))score='<span class="ea-score">'+(s<=1?s*100:s).toFixed(1)+'% match</span>'}div.innerHTML='<div class="d-flex justify-content-between gap-2 mb-2"><div><strong>'+esc(x.title||x.document_name||x.source||'Evidence '+(i+1))+'</strong><br><small class="text-muted">'+esc(x.type||x.source_type||'Source')+'</small></div>'+score+'</div><div class="small text-muted">'+fmt(x.text||x.content||x.chunk||x.summary||'')+'</div>';list.appendChild(div)});}
 function renderRoute(route){const routes=Array.isArray(route)?route:typeof route==='string'?route.split(/[,>|→]+/).map(s=>s.trim()).filter(Boolean):[];$id('ai_route_display').innerHTML=routes.length?routes.map(s=>'<span class="ea-route">'+esc(s)+'</span>').join(''):'<small>No route information</small>';$id('ai_query_route_details').textContent=routes.length?routes.join(' → '):'No route information returned.';}
 function renderStats(p){$id('ai_stat_records').textContent=Array.isArray(p.records)?p.records.length:(p.recordCount??p.record_count??0);$id('ai_stat_documents').textContent=Array.isArray(p.evidence)?p.evidence.length:(p.documentCount??p.document_count??0);$id('ai_stat_parcels').textContent=p.parcelCount??p.parcel_count??0;let c=p.confidence;$id('ai_stat_confidence').textContent=c==null?'--':Number.isFinite(Number(c))?((Number(c)<=1?Number(c)*100:Number(c)).toFixed(0)+'%'):'--';}
 function renderQuery(p){$id('ai_generated_sql').textContent=p.sql||p.generatedSql||p.generated_sql||'No SQL generated.';$id('ai_generated_spatial').textContent=p.spatialQuery||p.spatial_query||p.postgisQuery||p.postgis_query||'No spatial query generated.';$id('ai_generated_vector').textContent=p.vectorQuery||p.vector_query||p.vectorSearch||p.vector_search||'No vector search performed.';renderRoute(p.route||p.queryRoute||p.query_route||[]);}
 function initMap(){if(typeof ol==='undefined'){console.warn('OpenLayers is not loaded.');return;}if(map)return;try{if(typeof proj4!=='undefined'){proj4.defs('EPSG:2136','+proj=tmerc +lat_0=4.666666666666667 +lon_0=-1 +k=0.99975 +x_0=274319.7391633579 +y_0=0 +a=6378300 +b=6356751.689189189 +towgs84=-199,32,322,0,0,0,0 +to_meter=0.3047997101815088 +no_defs');if(typeof ol.proj.setProj4==='function')ol.proj.setProj4(proj4);}const projection=new ol.proj.Projection({code:'EPSG:2136',extent:[80935.4497355444,1209.0295731349593,1711780.3060929566,2358523.124783509],units:'ft',axisOrientation:'enu',global:false,worldExtent:[-3.79,1.4,2.1,11.16],getPointResolution:r=>r});if(!ol.proj.get('EPSG:2136'))ol.proj.addProjection(projection);const layers=[new ol.layer.Tile({title:'OpenStreetMap',source:new ol.source.OSM()}),new ol.layer.Tile({title:'Google Satellite & Roads',visible:false,source:new ol.source.XYZ({url:'https://mt0.google.com/vt/lyrs=y&hl=en&x={x}&y={y}&z={z}&s=Ga'})})];if(typeof getGeoServerEndPoint==='function'){const url=getGeoServerEndPoint()+'/geoserver/csau_geospatial/wms';[['Registration District','csau_geospatial:district',false],['Grid','csau_geospatial:gng_grid',false],['LRD Parcels','csau_geospatial:lc_spatial_objects',true]].forEach(a=>layers.push(new ol.layer.Tile({title:a[0],visible:a[2],source:new ol.source.TileWMS({url,params:{LAYERS:a[1],TILED:true},serverType:'geoserver',transition:0})})));}vectorSource=new ol.source.Vector();vectorLayer=new ol.layer.Vector({title:'AI Query Result',source:vectorSource,style:new ol.style.Style({stroke:new ol.style.Stroke({color:'#ef4444',width:3}),fill:new ol.style.Fill({color:'rgba(239,68,68,.18)'}),image:new ol.style.Circle({radius:7,fill:new ol.style.Fill({color:'#ef4444'}),stroke:new ol.style.Stroke({color:'#fff',width:2})})})});layers.push(vectorLayer);let controls=ol.control.defaults();if(ol.control.LayerSwitcher)controls=controls.extend([new ol.control.LayerSwitcher()]);map=new ol.Map({target:'ai_database_map',controls,layers,view:new ol.View({projection,extent:projection.getExtent(),center:[1187433.58822084,327091.107070208],zoom:8})});$id('ai_map_tab').addEventListener('shown.bs.tab',()=>setTimeout(()=>map.updateSize(),100));}catch(e){console.error('Unable to initialise AI map:',e);}}
 function clearMap(){if(vectorSource)vectorSource.clear()}
 function fitMap(){if(!map||!vectorSource)return;const extent=vectorSource.getExtent();if(!extent||!Number.isFinite(extent[0]))return;map.updateSize();map.getView().fit(extent,{size:map.getSize(),padding:[50,50,50,50],maxZoom:17,duration:500})}
 function renderSpatial(p){clearMap();if(!vectorSource||typeof ol==='undefined')return;const geo=p.geojson||p.geoJson||p.geometry_geojson||p.spatialGeojson,wkt=p.wkt||p.geometry_wkt||p.spatialWkt,projection=p.geojsonProjection||p.geojson_projection||p.projection||'EPSG:2136';try{if(geo){const obj=typeof geo==='string'?JSON.parse(geo):geo;vectorSource.addFeatures(new ol.format.GeoJSON().readFeatures(obj,{dataProjection:projection,featureProjection:'EPSG:2136'}))}if(wkt)vectorSource.addFeatures(new ol.format.WKT().readFeatures(wkt,{dataProjection:projection,featureProjection:'EPSG:2136'}));fitMap();}catch(e){console.error('Unable to render AI spatial result:',e)}}
 function renderResult(r){const p=payload(r),a=answer(r);addMessage('assistant',a);$id('ai_answer_empty').classList.add('d-none');$id('ai_answer_content').classList.remove('d-none');$id('ai_answer_text').innerHTML=fmt(a);renderRecords(p.records||p.rows||p.results||[]);renderEvidence(p.evidence||p.sources||p.documents||[]);renderQuery(p);renderStats(p);renderSpatial(p);}
 input.addEventListener('input',function(){this.style.height='auto';this.style.height=Math.min(this.scrollHeight,130)+'px'});input.addEventListener('keydown',e=>{if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();if(input.value.trim())form.requestSubmit?form.requestSubmit():form.dispatchEvent(new Event('submit',{cancelable:true}))}});
 form.addEventListener('submit',e=>{e.preventDefault();const msg=input.value.trim();if(!msg||send.disabled)return;addMessage('user',msg);input.value='';input.style.height='auto';loading(true);$.ajax({type:'POST',url:'ai_serv',data:{request_type:'send_agent_question',query:msg,chat_message:msg,ai_context:'database_assistant',query_mode:$id('ai_query_mode').value,result_limit:$id('ai_result_limit').value,use_transaction_database:$id('ai_source_transaction').checked,use_spatial_database:$id('ai_source_spatial').checked,use_vector_database:$id('ai_source_vector').checked,use_documents:$id('ai_source_documents').checked,use_knowledge_base:$id('ai_source_knowledge').checked,include_query_details:$id('ai_include_query_details').checked,current_region:$id('ai_current_region').value||'',timestamp:new Date().toISOString()},success:r=>{loading(false);const result=normalize(r);if(result&&(result.success===true||typeof result.success==='undefined'))renderResult(result);else addMessage('assistant','❌ '+(result.message||'The AI service was unable to process the query.'));input.focus()},error:(xhr,status,error)=>{loading(false);console.error('AI request failed:',status,error);let msg='Sorry, I encountered an error while processing your database question.';if(status==='timeout')msg='The AI query timed out. Please try a more specific question.';else if(xhr.status===0)msg='Network error. Please check your connection.';else if(xhr.status===403)msg='You do not have permission to perform this AI database query.';else if(xhr.status===500)msg='The AI/database service encountered a server error.';else if(xhr.responseText){try{msg=JSON.parse(xhr.responseText).message||msg}catch(ignore){}}addMessage('assistant','❌ '+msg);input.focus()}})});
 document.querySelectorAll('.elis-ai-page .ai-example-question').forEach(btn=>btn.addEventListener('click',()=>{input.value=btn.dataset.question||'';input.dispatchEvent(new Event('input'));input.focus()}));
 $id('ai_btn_clear_chat').addEventListener('click',()=>{if(!confirm('Clear the AI conversation?'))return;messages.querySelectorAll('.ea-message').forEach(x=>x.remove());addMessage('assistant','Conversation cleared. What would you like to ask about ELIS data?');clearMap()});
 $id('ai_btn_export_chat').addEventListener('click',()=>{let output='=== ELIS AI Database Assistant ===\nDate: '+new Date().toLocaleString()+'\n\n';messages.querySelectorAll('.ea-message').forEach(m=>{const content=m.querySelector('.ea-bubble');if(!content)return;const clone=content.cloneNode(true);clone.querySelector('.ea-time')?.remove();output+=(m.classList.contains('user')?'User':'AI Assistant')+': '+clone.textContent.trim()+'\n\n'});const url=URL.createObjectURL(new Blob([output],{type:'text/plain;charset=utf-8'})),a=document.createElement('a');a.href=url;a.download='elis-ai-database-chat-'+new Date().toISOString().substring(0,10)+'.txt';document.body.appendChild(a);a.click();a.remove();URL.revokeObjectURL(url)});
 $id('ai_btn_clear_map').addEventListener('click',clearMap);initMap();console.log('ELIS AI Database Assistant loaded.');
});
</script>

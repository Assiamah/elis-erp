   <label class="ea-source"><input class="form-check-input mt-2" type="checkbox" id="ai_source_documents" checked><span class="ea-icon"><i class="fas fa-file-alt"></i></span><span><strong>Documents / OCR</strong><small>Deeds, letters, reports, scanned documents and OCR text.</small></span></label>

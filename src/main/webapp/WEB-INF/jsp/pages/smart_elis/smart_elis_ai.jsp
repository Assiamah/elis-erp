  </div></section>
  <section class="ea-card mb-3"><div class="ea-card-head"><strong><i class="fas fa-sliders-h me-2"></i>Query Options</strong></div><div class="ea-card-body"><label class="form-label small fw-semibold" for="ai_query_mode">Query Mode</label><select id="ai_query_mode" class="form-select form-select-sm mb-3"><option value="auto" selected>Auto - AI Decides</option><option value="hybrid">Hybrid Analysis</option><option value="database">Transaction Database</option><option value="spatial">Geospatial / PostGIS</option><option value="rag">Documents / RAG</option><option value="vector">Vector Search</option></select><label class="form-label small fw-semibold" for="ai_result_limit">Maximum Records</label><select id="ai_result_limit" class="form-select form-select-sm mb-3"><option value="10">10</option><option value="25" selected>25</option><option value="50">50</option><option value="100">100</option></select><div class="form-check"><input class="form-check-input" type="checkbox" id="ai_include_query_details" checked><label class="form-check-label small" for="ai_include_query_details">Show technical query details</label></div></div></section>
  <section class="ea-card"><div class="ea-card-head"><strong><i class="fas fa-lightbulb me-2"></i>Suggested Questions</strong></div><div class="ea-card-body d-grid gap-2">
   <button type="button" class="btn btn-outline-success btn-sm ea-example ai-example-question" data-question="Show all pending land registration applications older than 30 days">Pending applications older than 30 days</button>
   <button type="button" class="btn btn-outline-success btn-sm ea-example ai-example-question" data-question="Which applications are currently delayed and at what workflow stage?">Find delayed applications and workflow stages</button>

.elis-ai-page .ea-hero h1,.elis-ai-page .ea-hero p,.elis-ai-page .ea-hero .breadcrumb-item,.elis-ai-page .ea-hero .breadcrumb-item.active,.elis-ai-page .ea-hero .breadcrumb-item a{color:white!important}
.elis-ai-page .ea-hero p{opacity:.87}.elis-ai-page .ea-hero .badge{background:rgba(255,255,255,.17)!important;color:white!important;border:1px solid rgba(255,255,255,.22)}
.elis-ai-page .ea-card{background:#fff;border:1px solid var(--ea-border);border-radius:14px;box-shadow:0 3px 14px rgba(7,74,48,.055);overflow:hidden}
.elis-ai-page .ea-card-head{background:linear-gradient(110deg,#07543f,#0b8961);color:white;padding:15px 18px;display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap}
.elis-ai-page .ea-card-head .text-primary,.elis-ai-page .ea-card-head .text-muted,.elis-ai-page .ea-card-head i{color:white!important}.elis-ai-page .ea-card-body{padding:17px}
.elis-ai-page .ea-source{display:flex;align-items:flex-start;gap:11px;padding:12px;border:1px solid var(--ea-border);border-radius:10px;margin-bottom:9px;background:#fff;cursor:pointer;transition:background .2s,border-color .2s}
.elis-ai-page .ea-source:hover{background:#f2fbf6;border-color:#68ba94}.elis-ai-page .ea-source .ea-icon{width:38px;height:38px;min-width:38px;border-radius:10px;display:flex;align-items:center;justify-content:center;background:var(--ea-mint);color:var(--ea-green)}
.elis-ai-page .ea-source strong{display:block;font-size:13px}.elis-ai-page .ea-source small{display:block;font-size:11px;color:var(--ea-muted);margin-top:3px}
.elis-ai-page .ea-example{font-size:12px;text-align:left;white-space:normal;line-height:1.5;border-color:#b7d9c7;color:var(--ea-dark)}.elis-ai-page .ea-example:hover{background:var(--ea-mint);color:var(--ea-dark);border-color:var(--ea-bright)}
.elis-ai-page .ea-chat{display:flex;flex-direction:column;min-height:610px}.elis-ai-page .ea-chat-head{background:linear-gradient(115deg,#064631,#0b9468);color:white;padding:17px 20px;display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap}
.elis-ai-page .ea-chat-head h5{color:white;margin:0}.elis-ai-page .ea-chat-head small{color:rgba(255,255,255,.85)}.elis-ai-page .ea-chat-head .ea-robot{width:44px;height:44px;border-radius:12px;display:grid;place-items:center;background:rgba(255,255,255,.18);font-size:20px}
.elis-ai-page .ea-messages{flex:1;overflow-y:auto;min-height:375px;max-height:510px;background:linear-gradient(#f8fcfa,#f2f9f5);padding:20px}.elis-ai-page .ea-message{display:flex;gap:10px;margin-bottom:16px}.elis-ai-page .ea-message.user{justify-content:flex-end}
.elis-ai-page .ea-avatar{width:34px;height:34px;min-width:34px;border-radius:50%;display:grid;place-items:center;background:var(--ea-green);color:white;font-size:11px;font-weight:700}.elis-ai-page .ea-message.user .ea-avatar{order:2;background:#24483b}
.elis-ai-page .ea-bubble{max-width:82%;background:white;border:1px solid var(--ea-border);border-radius:13px;padding:12px 15px;font-size:13px;line-height:1.6;overflow-wrap:anywhere;box-shadow:0 2px 8px rgba(0,0,0,.04)}.elis-ai-page .ea-message.user .ea-bubble{background:linear-gradient(120deg,#07543f,#0b8961);color:white;border:0}.elis-ai-page .ea-time{display:block;font-size:10px;opacity:.65;margin-top:5px}
.elis-ai-page .ea-typing{display:none;align-items:center;gap:10px;margin-bottom:12px}.elis-ai-page .ea-typing.active{display:flex}.elis-ai-page .ea-dots{background:white;border:1px solid var(--ea-border);border-radius:10px;padding:10px 15px}.elis-ai-page .ea-dots span{display:inline-block;width:7px;height:7px;margin:0 2px;border-radius:50%;background:var(--ea-green);animation:ea-bounce 1s infinite alternate}.elis-ai-page .ea-dots span:nth-child(2){animation-delay:.2s}.elis-ai-page .ea-dots span:nth-child(3){animation-delay:.4s}@keyframes ea-bounce{to{opacity:.2;transform:translateY(-4px)}}
.elis-ai-page .ea-compose{padding:16px 18px;border-top:1px solid var(--ea-border)}.elis-ai-page .ea-input-row{display:flex;gap:10px;align-items:flex-end}.elis-ai-page #ai_user_input{flex:1;resize:none;min-height:46px;max-height:130px;padding:11px 13px;border:1px solid #b9d8c8;border-radius:10px;background:#fafffc}.elis-ai-page #ai_user_input:focus,.elis-ai-page .form-select:focus{outline:0;border-color:var(--ea-bright);box-shadow:0 0 0 3px rgba(10,165,116,.13)}
.elis-ai-page .ea-send{min-width:95px;height:46px;border:0;border-radius:10px;color:white;background:linear-gradient(110deg,#07543f,#0b9468);font-weight:600}.elis-ai-page .ea-send:disabled{opacity:.6}
.elis-ai-page .ea-stat{border:1px solid var(--ea-border);background:#f6fcf8;border-radius:11px;padding:13px;text-align:center;height:100%}.elis-ai-page .ea-stat small{display:block;color:var(--ea-muted)}.elis-ai-page .ea-stat strong{font-size:22px;color:var(--ea-dark)}
.elis-ai-page .nav-tabs .nav-link{font-size:12px;color:var(--ea-dark)}.elis-ai-page .nav-tabs .nav-link.active{color:var(--ea-green);font-weight:700;border-bottom:3px solid var(--ea-bright)}.elis-ai-page #ai_result_table thead th{background:#086448;color:white;white-space:nowrap}.elis-ai-page #ai_result_table{font-size:12px}
.elis-ai-page .ea-empty{text-align:center;padding:43px 12px;color:#789184}.elis-ai-page .ea-empty i{font-size:32px;display:block;margin-bottom:10px}.elis-ai-page .ea-query{min-height:100px;max-height:280px;overflow:auto;white-space:pre-wrap;word-break:break-word;padding:13px;border-radius:9px;background:#12251d;color:#baf2d4;font-size:11px}
.elis-ai-page .ea-route{display:inline-block;margin:2px;padding:4px 9px;border-radius:30px;background:#dff5e8;color:#07543f;font-size:10px;font-weight:600}.elis-ai-page #ai_database_map{height:470px;width:100%;background:#edf3ee;border-radius:9px}.elis-ai-page .ea-evidence{padding:13px;border:1px solid var(--ea-border);border-radius:10px;margin-bottom:10px}.elis-ai-page .ea-score{background:#def5e6;color:#07543f;border-radius:20px;padding:3px 8px;font-size:10px}
.elis-ai-page .ea-answer{background:#eaf8f0;border:1px solid #c5e6d1;color:#173e2c;border-radius:9px;padding:16px}.elis-ai-page .form-check-input:checked{background-color:#0b8961;border-color:#0b8961}
@media(max-width:767px){.elis-ai-page .ea-input-row{flex-direction:column;align-items:stretch}.elis-ai-page .ea-send{width:100%}.elis-ai-page .ea-bubble{max-width:88%}.elis-ai-page .ea-hero{padding:19px}}
</style>

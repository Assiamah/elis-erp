<style>
.elis-ai-page{--ea-deep:#064631;--ea-dark:#07543f;--ea-green:#087b56;--ea-bright:#0aa574;--ea-mint:#eaf8f0;--ea-border:#dbece2;--ea-text:#193a30;--ea-muted:#667d72;color:var(--ea-text)}

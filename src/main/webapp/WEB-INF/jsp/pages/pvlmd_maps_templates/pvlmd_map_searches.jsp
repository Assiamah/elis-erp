ype="button" class="btn btn-outline-info" id="pvlmd_btn_visualise_search" data-bs-tooltip="tooltip" title="Visualise Search"><i class="fas fa-search me-1"></i>Search</button><button type="button" class="btn btn-outline-secondary" id="pvlmd_btngeneratesearchreport" data-bs-tooltip="tooltip" title="Print Search Report"><i class="fas fa-file-alt me-1"></i>Report</button></div></div><div class="map-frame"><div id="alld-map"></div></div></div><div class="card-footer bg-transparent py-3"><div class="d-flex justify-content-between flex-wrap gap-2 small text-muted"><span><i class="fas fa-info-circle me-1"></i>Digital Map Search - All Divisions</span><span><i class="fas fa-sync-alt me-1"></i>Last updated: Just now</span></div></div></div>
<div class="card"><div class="card-header"><h5 class="mb-0 fw-bold"><i class="fas fa-list-alt me-2"></i>Transaction Search Results</h5></div><div class="card-body"><div class="table-responsive"><table class="table table-hover table-bordered display" id="pvlmd_transaction_all_dataTable" width="100%" cellspacing="0"><thead><tr><th>#</th><th>Job Number</th><th>Certificate Number</th><th>File Number</th><th>Property Number</th><th>Grantor</th><th>Grantee</th><th>Instrument Type</th><th>Transaction Date</th><th>Status</th><th class="text-center">Action</th></tr></thead><tbody></tbody></table></div></div><div class="card-footer bg-transparent py-3"><div class="d-flex justify-content-between flex-wrap gap-2 small text-muted"><span><i class="fas fa-database me-1"></i>Showing transaction records</span><span id="transactionRecordCount"><i class="fas fa-file-alt me-1"></i>Total: 0 records</span></div></div></div>
</div></div></div></div>
<script>
document.addEventListener('DOMContentLoaded',function(){
 if(window.bootstrap&&bootstrap.Tooltip){document.querySelectorAll('[data-bs-tooltip="tooltip"]').forEach(function(el){new bootstrap.Tooltip(el);});}
 if(!window.jQuery||!$.fn.DataTable)return;
 if($.fn.DataTable.isDataTable('#pvlmd_transaction_all_dataTable'))$('#pvlmd_transaction_all_dataTable').DataTable().destroy();
 var transactionTable=$('#pvlmd_transaction_all_dataTable').DataTable({pageLength:10,lengthMenu:[[10,25,50,-1],[10,25,50,'All']],responsive:true,order:[[0,'desc']],columnDefs:[{orderable:false,targets:[10]}],language:{search:"<i class='fas fa-search me-1'></i>Search:",searchPlaceholder:'Search transactions...',lengthMenu:'Show _MENU_ entries',info:'Showing _START_ to _END_ of _TOTAL_ transactions',infoEmpty:'No transactions available',infoFiltered:'(filtered from _MAX_ total transactions)',zeroRecords:'No matching transactions found'}});
 function safe(v){return $('<div>').text(v==null?'N/A':String(v)).html();}
 $('#pvlmd_btn_search_transaction').on('click',function(){var searchText=$('#pvlmd_search_transaction_by_text').val().trim();if(!searchText){Swal.fire({title:'Warning',text:'Please enter a search term',icon:'warning',confirmButtonText:'OK'});return;}var btn=$(this);btn.prop('disabled',true).html('<span class="spinner-border spinner-border-sm"></span>');$.ajax({type:'POST',url:'Case_Management_Serv',data:{request_type:'search_transactions',search_text:searchText},dataType:'json',success:function(response){transactionTable.clear();if(Array.isArray(response)&&response.length){response.forEach(function(item,index){var status=safe(item.status||'Active');var statusBadge='<span class="badge text-bg-success">'+status+'</span>';if(item.status==='Inactive')statusBadge='<span class="badge text-bg-danger">Inactive</span>';else if(item.status==='Pending')statusBadge='<span class="badge text-bg-warning text-dark">Pending</span>';var job=safe(item.job_number);transactionTable.row.add([index+1,'<span class="fw-semibold">'+job+'</span>',safe(item.certificate_number),safe(item.file_number),safe(item.property_number),safe(item.grantor),safe(item.grantee),safe(item.instrument_type),safe(item.transaction_date),statusBadge,'<div class="d-flex gap-1 justify-content-center"><button class="btn btn-sm btn-info view-transaction" data-job="'+job+'" title="View Details"><i class="fas fa-eye"></i></button><button class="btn btn-sm btn-primary locate-transaction" data-job="'+job+'" title="Locate on Map"><i class="fas fa-map-marker-alt"></i></button></div>']);});$('#transactionRecordCount').html('<i class="fas fa-file-alt me-1"></i> Total: '+response.length+' records');}else{$('#transactionRecordCount').html('<i class="fas fa-file-alt me-1"></i> Total: 0 records');}transactionTable.draw();},error:function(){Swal.fire({title:'Error',text:'An error occurred while searching transactions',icon:'error',confirmButtonText:'OK'});},complete:function(){btn.prop('disabled',false).html('<i class="fas fa-search me-1"></i> Search');}});});
 $('#pvlmd_btn_clear_transaction_search').on('click',function(){$('#pvlmd_search_transaction_by_text').val('');transactionTable.clear().draw();$('#transactionRecordCount').html('<i class="fas fa-file-alt me-1"></i> Total: 0 records');});
 $(document).on('click','.view-transaction',function(){Swal.fire({title:'Transaction Details',text:'View details for job: '+$(this).data('job'),icon:'info',confirmButtonText:'OK'});});
 $(document).on('click','.locate-transaction',function(){Swal.fire({title:'Locate Transaction',text:'Locating transaction: '+$(this).data('job')+' on map...',icon:'info',timer:2000,showConfirmButton:false});});
 $('#pvlmd_search_transaction_by_text').on('keypress',function(e){if(e.which===13)$('#pvlmd_btn_search_transaction').click();});
});
</script>

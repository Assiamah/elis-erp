.ol-popup{position:absolute;background:white;box-shadow:0 8px 25px rgba(7,84,63,.18);padding:15px;border-radius:12px;border:1px solid #b9dcca;bottom:12px;left:-50px;min-width:250px;max-width:400px;max-height:350px;display:none;z-index:1000;overflow:auto}.ol-popup:after,.ol-popup:before{top:100%;border:solid transparent;content:" ";height:0;width:0;position:absolute;pointer-events:none}.ol-popup:after{border-top-color:white;border-width:10px;left:48px;margin-left:-10px}.ol-popup:before{border-top-color:#b9dcca;border-width:11px;left:48px;margin-left:-11px}.ol-popup-closer{text-decoration:none;position:absolute;top:2px;right:8px;font-size:20px;cursor:pointer;color:#087f5b}.ol-popup h4{margin:0 0 10px;color:#07543f}.ol-popup .feature-properties{margin:5px 0;font-size:13px;line-height:1.5}.ol-popup hr{margin:8px 0;border:0;border-top:1px solid #d7ebdf}.ol-popup strong{color:#07543f}.ol-popup table{font-size:12px;border-collapse:collapse;width:100%}.ol-popup td{padding:4px 8px;border:1px solid #d7ebdf}.ol-popup tr:nth-child(even){background:#f2faf5}
